---
import Layout from "./Layout.astro";
import { formatDate } from "../utils/date";

const { frontmatter } = Astro.props;
const pubDate = formatDate(frontmatter.pubDate);
const tags: string[] = frontmatter.tags ?? [];
---

<Layout title={`tomy | ${frontmatter.title}`}>
  <!-- Reading progress -->
  <div class="read-progress" id="read-progress" aria-hidden="true"></div>

  <article class="post">
    <header class="post-header">
      <a href="/blog/" class="back-link reveal">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2.2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 19-7-7 7-7" />
          <path d="M19 12H5" />
        </svg>
        <span>Back to Blog</span>
      </a>

      <div class="post-meta reveal reveal-delay-1">
        <time class="post-date">{pubDate}</time>
        {frontmatter.author && <span class="post-author">by {frontmatter.author}</span>}
      </div>

      <h1 class="reveal reveal-delay-1">{frontmatter.title}</h1>

      {frontmatter.description && (
        <p class="post-desc reveal reveal-delay-2">{frontmatter.description}</p>
      )}

      {tags.length > 0 && (
        <div class="post-tags reveal reveal-delay-3">
          {tags.map((tag: string) => (
            <a href={`/tags/${tag}`} class="post-tag">#{tag}</a>
          ))}
        </div>
      )}
    </header>

    {frontmatter.image?.url && (
      <div class="post-image notion-block reveal reveal-delay-3">
        <img src={frontmatter.image.url} alt={frontmatter.image.alt || frontmatter.title} />
      </div>
    )}

    <div class="post-content reveal reveal-delay-3">
      <slot />
    </div>

    <footer class="post-footer reveal">
      <a href="/blog/" class="post-more">
        <span>Read more posts</span>
        <span class="btn-arrow">→</span>
      </a>
    </footer>
  </article>
</Layout>

<style>
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 100%;
    z-index: 120;
    background: var(--gradient-brand);
    background-size: 250% auto;
    animation: gradient-flow 7s linear infinite;
    transform: scaleX(0);
    transform-origin: left;
  }

  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 0 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .back-link:hover { color: var(--accent); }

  .back-link svg { transition: transform 0.35s var(--ease-spring); }
  .back-link:hover svg { transform: translateX(-4px); }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .post-date { color: var(--accent); }

  .post-author::before {
    content: "·";
    margin-right: 0.75rem;
    color: var(--text-faint);
  }

  .post-header h1 {
    margin: 0.7rem 0;
    font-size: clamp(1.75rem, 5vw, 2.75rem);
  }

  .post-desc {
    font-size: 1.02rem;
    color: var(--text-secondary);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .post-tag {
    padding: 0.25rem 0.7rem;
    border-radius: 1rem;
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    transition: all 0.3s var(--ease-smooth);
  }

  .post-tag:hover {
    color: var(--accent-hover);
    border-color: var(--accent-glow-strong);
    background: var(--accent-dim);
  }

  .post-image {
    margin: 1.5rem 0;
    padding: 0;
    overflow: hidden;
  }

  .post-image img {
    width: 100%;
  }

  /* ---- Content ---- */
  .post-content {
    font-size: 0.98rem;
    line-height: 1.95;
    color: var(--text-secondary);
  }

  /* The layout header already renders the title, so an h1 in the body is a duplicate. */
  .post-content :global(h1) {
    display: none;
  }

  .post-content :global(h2) {
    margin-top: 2.75rem;
    margin-bottom: 0.85rem;
    font-size: 1.5rem;
    color: var(--text-primary);
  }

  .post-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.6rem;
    font-size: 1.15rem;
    color: var(--text-primary);
  }

  .post-content :global(p) {
    margin-bottom: 1.15rem;
  }

  .post-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(167, 139, 250, 0.4);
    transition: text-decoration-color 0.25s ease;
  }

  .post-content :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .post-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(167, 139, 250, 0.12);
    color: var(--accent-hover);
    padding: 0.15em 0.4em;
    border-radius: 0.25em;
  }

  .post-content :global(pre) {
    background: #0d0d15;
    color: #cdd6f4;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 1.35rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .post-content :global(pre code) {
    background: none;
    color: inherit;
    padding: 0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.15rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.45rem;
    list-style: disc;
  }

  .post-content :global(li)::marker {
    color: var(--accent);
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 0.85rem 1.15rem;
    margin: 1.5rem 0;
    background: var(--accent-dim);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text-secondary);
  }

  .post-content :global(img) {
    border-radius: var(--radius);
    border: 1px solid var(--border-subtle);
    margin: 1.5rem 0;
  }

  /* ---- Footer ---- */
  .post-footer {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .post-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .post-more:hover { color: var(--accent); }
  .post-more:hover .btn-arrow { transform: translateX(5px); }
</style>

<script>
  let teardown: (() => void) | null = null;

  function initReadProgress() {
    teardown?.();

    const bar = document.getElementById("read-progress");
    if (!bar) return;

    const onScroll = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? window.scrollY / max : 0;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    teardown = () => window.removeEventListener("scroll", onScroll);
  }

  document.addEventListener("astro:page-load", initReadProgress);
</script>
