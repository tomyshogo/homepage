---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
---

<Layout title={`tomy | ${frontmatter.title}`}>
  <article class="post reveal">
    <header class="post-header">
      <a href="/works/" class="back-link">← Back to Works</a>
      <div class="section-label">{frontmatter.pubDate?.slice(0, 10)}</div>
      <h1>{frontmatter.title}</h1>
      {frontmatter.description && (
        <p class="post-desc">{frontmatter.description}</p>
      )}
      {frontmatter.author && (
        <p class="post-author">by {frontmatter.author}</p>
      )}
    </header>

    {frontmatter.image?.url && (
      <div class="post-image notion-block">
        <img src={frontmatter.image.url} alt={frontmatter.image.alt || frontmatter.title} />
      </div>
    )}

    <div class="post-content">
      <slot />
    </div>
  </article>
</Layout>

<style>
  .post {
    max-width: 700px;
    margin: 0 auto;
    padding: 3rem 0;
  }

  .back-link {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    padding: 0.3rem 0.6rem;
    border-radius: 0.375rem;
    transition: all 0.15s ease;
  }

  .back-link:hover {
    color: var(--accent);
    background: var(--accent-dim);
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .post-header h1 {
    margin: 0.5rem 0;
    font-size: clamp(1.4rem, 4vw, 2rem);
  }

  .post-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  .post-author {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  .post-image {
    margin: 1.5rem 0;
    overflow: hidden;
    padding: 0;
  }

  .post-image img {
    width: 100%;
    max-width: 500px;
  }

  .post-content {
    font-size: 0.95rem;
    line-height: 1.9;
    color: var(--text-secondary);
  }

  .post-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .post-content :global(h3) {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .post-content :global(p) {
    margin-bottom: 1rem;
  }

  .post-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(124, 58, 237, 0.3);
  }

  /* Notion-style inline code */
  .post-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(135, 131, 120, 0.1);
    color: #eb5757;
    padding: 0.15em 0.4em;
    border-radius: 0.25em;
  }

  .post-content :global(pre) {
    background: #1e1e2e;
    color: #cdd6f4;
    border-radius: var(--radius);
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.25rem 0;
    font-size: 0.88rem;
  }

  .post-content :global(pre code) {
    background: none;
    color: inherit;
    padding: 0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.4rem;
    list-style: disc;
  }

  /* Notion-style callout */
  .post-content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 0.75rem 1rem;
    margin: 1.25rem 0;
    background: var(--accent-dim);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text-secondary);
  }
</style>
