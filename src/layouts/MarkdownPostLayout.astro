---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
---

<Layout title={`tomy | ${frontmatter.title}`}>
  <article class="post-article reveal">
    <header class="post-header">
      <a href="/works/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 19-7-7 7-7"/>
          <path d="M19 12H5"/>
        </svg>
        Back to Works
      </a>
      <p class="mono-label">{frontmatter.pubDate?.slice(0, 10)}</p>
      <h1>{frontmatter.title}</h1>
      {frontmatter.description && (
        <p class="post-desc">{frontmatter.description}</p>
      )}
      {frontmatter.author && (
        <p class="post-author">by {frontmatter.author}</p>
      )}
    </header>

    {frontmatter.image?.url && (
      <div class="post-image">
        <img src={frontmatter.image.url} alt={frontmatter.image.alt || frontmatter.title} />
      </div>
    )}

    <div class="post-content">
      <slot />
    </div>
  </article>
</Layout>

<style>
  .post-article {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 0;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    transition: color 0.3s ease;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .post-header h1 {
    margin: 0.75rem 0;
    font-size: clamp(1.5rem, 4vw, 2.2rem);
  }

  .post-desc {
    font-size: 1.1rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  .post-author {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.75rem;
  }

  .post-image {
    margin: 2rem 0;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-md);
  }

  .post-image img {
    width: 100%;
    max-width: 500px;
  }

  .post-content {
    font-size: 1rem;
    line-height: 1.9;
    color: var(--text-secondary);
  }

  .post-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .post-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .post-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--bg-secondary);
    padding: 0.15em 0.4em;
    border-radius: 0.3em;
    border: 1px solid var(--border-subtle);
  }

  .post-content :global(pre) {
    background: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .post-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    color: inherit;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
    list-style: disc;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--text-muted);
    font-style: italic;
  }
</style>
