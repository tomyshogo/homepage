---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import selfie from "../assets/IMG_4381.jpg";

const pageTitle = "tomy | Software Engineer";

const roles = ["Software Engineer", "IoT Builder", "Game Dev Enthusiast"];

const techStack = [
  "JavaScript", "TypeScript", "C#", "Python", "Java",
  "Swift", "AWS", "Firebase", "Unity", "PostgreSQL",
];
---

<Layout title={pageTitle}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-badge reveal">
          <span class="badge-dot"></span>
          Available for work
        </div>
        <h1 class="hero-title reveal reveal-delay-1">
          Hi, I'm <span class="gradient-text">tomy</span>
        </h1>
        <div class="role-rotator reveal reveal-delay-2" aria-label={roles.join(" / ")}>
          <span class="role-prefix">&gt;</span>
          <span class="role-words">
            {roles.map((role, i) => (
              <span class="role-word" style={`--i: ${i}`}>{role}</span>
            ))}
          </span>
          <span class="role-caret"></span>
        </div>
        <p class="hero-desc reveal reveal-delay-2">
          テクノロジー、プログラミング、デザインに情熱を持つソフトウェアエンジニア。
          IoTプロダクトやゲーム開発にも興味を持ち、幅広い技術スタックで開発に取り組んでいます。
        </p>
        <div class="hero-actions reveal reveal-delay-3">
          <a href="/about/" class="btn-primary">About Me <span class="btn-arrow">→</span></a>
          <a href="/works/" class="btn-ghost">Works</a>
        </div>
      </div>
      <div class="hero-image reveal reveal-delay-2">
        <div class="orbit-ring"></div>
        <div class="image-glow"></div>
        <div class="image-frame">
          <Image
            src={selfie}
            alt="tomy - Software Engineer"
            width={400}
            height={400}
            class="portrait"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Tech marquee -->
  <section class="marquee reveal" aria-label="Tech Stack">
    <div class="marquee-fade marquee-fade-left"></div>
    <div class="marquee-track">
      {[0, 1].map((dup) => (
        <div class="marquee-group" aria-hidden={dup === 1}>
          {techStack.map((tech) => (
            <span class="marquee-item">
              <span class="marquee-dot"></span>
              {tech}
            </span>
          ))}
        </div>
      ))}
    </div>
    <div class="marquee-fade marquee-fade-right"></div>
  </section>

  <!-- Bento grid -->
  <section class="bento">
    <div class="bento-grid">
      <a href="/about/" class="bento-item bento-lg glow-card reveal">
        <span class="bento-num">01</span>
        <h3>About</h3>
        <p>スキル・経歴について</p>
        <span class="bento-arrow">→</span>
      </a>
      <a href="/works/" class="bento-item glow-card reveal reveal-delay-1">
        <span class="bento-num">02</span>
        <h3>Works</h3>
        <p>個人プロジェクト紹介</p>
        <span class="bento-arrow">→</span>
      </a>
      <a href="https://github.com/tomyshogo" target="_blank" rel="noopener noreferrer" class="bento-item glow-card reveal reveal-delay-2">
        <span class="bento-num">03</span>
        <h3>GitHub</h3>
        <p>オープンソース活動</p>
        <span class="bento-arrow">↗</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    padding: 5rem 0 4rem;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 2rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 8px rgba(74, 222, 128, 0.6);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .hero-title {
    margin: 0 0 1rem;
  }

  /* Rotating role text */
  .role-rotator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    height: 1.6em;
  }

  .role-prefix {
    color: var(--accent);
    font-weight: 600;
  }

  .role-words {
    position: relative;
    display: inline-block;
    height: 1.6em;
    min-width: 20ch;
    overflow: hidden;
  }

  .role-word {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(110%);
    animation: role-cycle 9s infinite;
    animation-delay: calc(var(--i) * 3s);
    color: var(--accent-2);
  }

  @keyframes role-cycle {
    0% { opacity: 0; transform: translateY(110%); }
    3.5%, 30% { opacity: 1; transform: translateY(0); }
    33.5%, 100% { opacity: 0; transform: translateY(-110%); }
  }

  .role-caret {
    width: 8px;
    height: 1.1em;
    background: var(--accent-2);
    opacity: 0.7;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero-desc {
    max-width: 460px;
    font-size: 1rem;
    line-height: 1.9;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .btn-primary {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.75rem 1.6rem;
    background: linear-gradient(135deg, #8b5cf6, #7c3aed);
    color: #ffffff;
    border-radius: 0.65rem;
    overflow: hidden;
    transition: all 0.3s var(--ease-out-expo);
    box-shadow: 0 4px 20px rgba(139, 92, 246, 0.35);
  }

  /* Shine sweep */
  .btn-primary::before {
    content: "";
    position: absolute;
    top: 0;
    left: -80%;
    width: 60%;
    height: 100%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.25), transparent);
    transform: skewX(-20deg);
    transition: left 0.6s ease;
  }

  .btn-primary:hover::before {
    left: 130%;
  }

  .btn-primary:hover {
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(139, 92, 246, 0.5);
  }

  .btn-arrow {
    transition: transform 0.3s var(--ease-spring);
  }

  .btn-primary:hover .btn-arrow {
    transform: translateX(4px);
  }

  .btn-ghost {
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.75rem 1.6rem;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 0.65rem;
    background: var(--bg-card);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.3s var(--ease-out-expo);
  }

  .btn-ghost:hover {
    border-color: var(--accent-glow-strong);
    color: var(--text-primary);
    background: var(--accent-dim);
    transform: translateY(-2px);
  }

  /* Portrait */
  .hero-image {
    position: relative;
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  .orbit-ring {
    position: absolute;
    inset: -14px;
    z-index: 0;
    border-radius: calc(var(--radius-lg) + 14px);
    background: conic-gradient(
      from var(--ring-angle, 0deg),
      transparent 0%,
      rgba(167, 139, 250, 0.7) 12%,
      rgba(34, 211, 238, 0.5) 24%,
      transparent 40%
    );
    animation: spin-ring 5s linear infinite;
    filter: blur(10px);
    opacity: 0.9;
  }

  @property --ring-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  @keyframes spin-ring {
    to { --ring-angle: 360deg; }
  }

  .image-glow {
    position: absolute;
    width: 320px;
    height: 320px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(139, 92, 246, 0.25) 0%, transparent 70%);
    border-radius: 50%;
    z-index: 0;
    filter: blur(30px);
  }

  .image-frame {
    position: relative;
    z-index: 1;
    width: 270px;
    height: 270px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-medium);
    box-shadow: var(--shadow-lg);
  }

  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out-expo);
  }

  .image-frame:hover .portrait {
    transform: scale(1.05);
  }

  /* Marquee */
  .marquee {
    position: relative;
    margin: 1rem 0 3rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 28s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    to { transform: translateX(-50%); }
  }

  .marquee-group {
    display: flex;
    flex-shrink: 0;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .marquee-item:hover {
    color: var(--accent-hover);
  }

  .marquee-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.6;
  }

  .marquee-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 90px;
    z-index: 2;
    pointer-events: none;
  }

  .marquee-fade-left {
    left: 0;
    background: linear-gradient(90deg, var(--bg-primary), transparent);
  }

  .marquee-fade-right {
    right: 0;
    background: linear-gradient(-90deg, var(--bg-primary), transparent);
  }

  /* Bento */
  .bento-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 1rem;
  }

  .bento-item {
    padding: 1.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    cursor: pointer;
    min-height: 160px;
  }

  .bento-num {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    margin-bottom: 0.4rem;
    transition: color 0.25s ease;
  }

  .bento-item:hover .bento-num {
    color: var(--accent);
  }

  .bento-item h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    transition: color 0.25s ease;
  }

  .bento-item p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .bento-arrow {
    font-size: 1.1rem;
    color: var(--accent);
    margin-top: auto;
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.3s var(--ease-spring);
  }

  .bento-item:hover .bento-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .bento-item:hover h3 {
    color: var(--accent-hover);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      padding: 2.5rem 0;
    }

    .hero-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
    }

    .hero-badge {
      margin-left: auto;
      margin-right: auto;
    }

    .role-rotator {
      justify-content: center;
    }

    .role-words {
      min-width: 0;
      width: 20ch;
      text-align: left;
    }

    .hero-desc {
      max-width: 100%;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-image {
      order: -1;
      margin: 0 auto;
    }

    .image-frame {
      width: 200px;
      height: 200px;
    }

    .image-glow {
      width: 240px;
      height: 240px;
    }

    .bento-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image,
    .orbit-ring,
    .marquee-track,
    .role-word,
    .badge-dot {
      animation: none;
    }

    .role-word {
      position: static;
      opacity: 1;
      transform: none;
    }

    .role-word:not(:first-child) {
      display: none;
    }
  }
</style>
