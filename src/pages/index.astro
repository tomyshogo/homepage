---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import selfie from "../assets/IMG_4381.jpg";

const pageTitle = "tomy | Software Engineer";
---

<Layout title={pageTitle}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-badge reveal">
          <span class="badge-dot"></span>
          <span>Software Engineer</span>
        </div>
        <h1 class="hero-title reveal reveal-delay-1">
          Hi, I'm <span class="accent">tomy</span>
        </h1>
        <p class="hero-desc reveal reveal-delay-2">
          テクノロジー、プログラミング、デザインに情熱を持つソフトウェアエンジニア。
          IoTプロダクトやゲーム開発にも興味を持ち、幅広い技術スタックで開発に取り組んでいます。
        </p>
        <div class="hero-actions reveal reveal-delay-3">
          <a href="/about/" class="btn-primary">
            About Me
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
          <a href="/works/" class="btn-secondary">Works</a>
        </div>
      </div>
      <div class="hero-image reveal reveal-delay-2">
        <div class="image-frame">
          <Image
            src={selfie}
            alt="tomy - Software Engineer"
            width={400}
            height={400}
            class="portrait"
          />
        </div>
        <div class="image-decoration"></div>
      </div>
    </div>
  </section>

  <!-- Quick Links -->
  <section class="quick-links reveal reveal-delay-5">
    <div class="link-grid">
      <a href="/about/" class="quick-card">
        <div class="card-number">01</div>
        <h3>About</h3>
        <p>スキル・経歴について</p>
        <span class="card-arrow">&rarr;</span>
      </a>
      <a href="/works/" class="quick-card">
        <div class="card-number">02</div>
        <h3>Works</h3>
        <p>ブログ・活動記録</p>
        <span class="card-arrow">&rarr;</span>
      </a>
      <a href="https://github.com/tomyshogo" target="_blank" rel="noopener noreferrer" class="quick-card">
        <div class="card-number">03</div>
        <h3>GitHub</h3>
        <p>オープンソース活動</p>
        <span class="card-arrow">&rarr;</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: 5rem 0 4rem;
    margin: -2rem -2rem 0;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: var(--gradient-hero);
    z-index: -1;
  }

  .hero-content {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1rem 0.4rem 0.6rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 2rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-secondary);
    box-shadow: var(--shadow-sm);
    margin-bottom: 1.25rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.4);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-title {
    margin: 0 0 1.25rem;
    line-height: 1.1;
  }

  .accent {
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-desc {
    max-width: 480px;
    font-size: 1.05rem;
    line-height: 1.9;
    color: var(--text-secondary);
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.8rem 1.75rem;
    background: var(--gradient-accent);
    color: #ffffff;
    border-radius: 0.75rem;
    transition: all 0.3s var(--ease-out-expo);
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
  }

  .btn-primary:hover {
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
  }

  .btn-secondary {
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.8rem 1.75rem;
    border: 1.5px solid var(--border-subtle);
    color: var(--text-secondary);
    border-radius: 0.75rem;
    background: var(--bg-card);
    transition: all 0.3s var(--ease-out-expo);
    box-shadow: var(--shadow-sm);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  /* Portrait */
  .hero-image {
    position: relative;
  }

  .image-frame {
    position: relative;
    width: 300px;
    height: 300px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 4px solid #ffffff;
  }

  .image-decoration {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: var(--radius-lg);
    border: 2px dashed rgba(99, 102, 241, 0.2);
    top: 16px;
    left: 16px;
    z-index: -1;
  }

  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 4px);
    transition: transform 0.5s ease;
  }

  .image-frame:hover .portrait {
    transform: scale(1.03);
  }

  /* Quick Links */
  .quick-links {
    margin-top: 1rem;
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .quick-card {
    padding: 2rem;
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: all 0.3s var(--ease-out-expo);
    text-decoration: none;
    position: relative;
    background: var(--gradient-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
  }

  .quick-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-card-hover);
    border-color: rgba(99, 102, 241, 0.2);
  }

  .card-number {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0.3;
    line-height: 1;
  }

  .quick-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0.25rem 0 0;
  }

  .quick-card p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .card-arrow {
    font-size: 1.3rem;
    color: var(--accent);
    margin-top: auto;
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.3s var(--ease-out-expo);
  }

  .quick-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      padding: 3rem 2rem;
    }

    .hero-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
    }

    .hero-badge {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-desc {
      max-width: 100%;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-image {
      order: -1;
    }

    .image-frame {
      width: 220px;
      height: 220px;
      margin: 0 auto;
    }

    .image-decoration {
      width: 220px;
      height: 220px;
      top: 12px;
      left: calc(50% - 98px);
    }

    .link-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
