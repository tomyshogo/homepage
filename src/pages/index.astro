---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import selfie from "../assets/IMG_4381.jpg";

const pageTitle = "tomy | Software Engineer";
---

<Layout title={pageTitle}>
  <!-- Hero Section - Notion-style clean + Raycast glow -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-badge reveal">
          <span class="badge-dot"></span>
          Available for work
        </div>
        <h1 class="hero-title reveal reveal-delay-1">
          Hi, I'm <span class="name-accent">tomy</span> 👋
        </h1>
        <p class="hero-desc reveal reveal-delay-2">
          テクノロジー、プログラミング、デザインに情熱を持つソフトウェアエンジニア。
          IoTプロダクトやゲーム開発にも興味を持ち、幅広い技術スタックで開発に取り組んでいます。
        </p>
        <div class="hero-actions reveal reveal-delay-3">
          <a href="/about/" class="btn-primary">About Me →</a>
          <a href="/works/" class="btn-ghost">Works</a>
        </div>
      </div>
      <div class="hero-image reveal reveal-delay-2">
        <div class="image-glow"></div>
        <div class="image-frame">
          <Image
            src={selfie}
            alt="tomy - Software Engineer"
            width={400}
            height={400}
            class="portrait"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Bento Grid - Raycast-inspired mixed layout -->
  <section class="bento reveal reveal-delay-4">
    <div class="bento-grid">
      <a href="/about/" class="bento-item bento-lg glow-card">
        <span class="bento-emoji">🧑‍💻</span>
        <h3>About</h3>
        <p>スキル・経歴について</p>
        <span class="bento-arrow">→</span>
      </a>
      <a href="/works/" class="bento-item glow-card">
        <span class="bento-emoji">📝</span>
        <h3>Works</h3>
        <p>ブログ・活動記録</p>
        <span class="bento-arrow">→</span>
      </a>
      <a href="https://github.com/tomyshogo" target="_blank" rel="noopener noreferrer" class="bento-item glow-card">
        <span class="bento-emoji">🐙</span>
        <h3>GitHub</h3>
        <p>オープンソース活動</p>
        <span class="bento-arrow">↗</span>
      </a>
    </div>
  </section>

  <!-- Tech highlight strip -->
  <section class="tech-strip reveal reveal-delay-5">
    <div class="strip-inner">
      <span class="strip-label">Tech Stack</span>
      <div class="strip-items">
        <span class="strip-tag">JavaScript</span>
        <span class="strip-tag">C#</span>
        <span class="strip-tag">Python</span>
        <span class="strip-tag">AWS</span>
        <span class="strip-tag">Swift</span>
        <span class="strip-tag">Unity</span>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    padding: 4rem 0 3rem;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 2rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 6px rgba(34, 197, 94, 0.4);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .hero-title {
    margin: 0 0 1rem;
  }

  .name-accent {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: rgba(124, 58, 237, 0.3);
    text-underline-offset: 4px;
    text-decoration-thickness: 3px;
  }

  .hero-desc {
    max-width: 460px;
    font-size: 1rem;
    line-height: 1.9;
  }

  .hero-actions {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .btn-primary {
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.7rem 1.5rem;
    background: var(--accent);
    color: #ffffff;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
    box-shadow: 0 1px 3px rgba(124, 58, 237, 0.3);
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);
  }

  .btn-ghost {
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.7rem 1.5rem;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 0.5rem;
    background: var(--bg-card);
    transition: all 0.2s ease;
  }

  .btn-ghost:hover {
    border-color: var(--border-medium);
    color: var(--text-primary);
    background: var(--bg-secondary);
  }

  /* Portrait with Raycast glow */
  .hero-image {
    position: relative;
  }

  .image-glow {
    position: absolute;
    width: 280px;
    height: 280px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(124, 58, 237, 0.1) 0%, transparent 70%);
    border-radius: 50%;
    z-index: 0;
    filter: blur(20px);
  }

  .image-frame {
    position: relative;
    z-index: 1;
    width: 260px;
    height: 260px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-lg);
  }

  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .image-frame:hover .portrait {
    transform: scale(1.03);
  }

  /* Bento Grid - Raycast-inspired */
  .bento {
    margin-top: 1rem;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 1rem;
  }

  .bento-item {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    cursor: pointer;
  }

  .bento-emoji {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }

  .bento-item h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .bento-item p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .bento-arrow {
    font-size: 1rem;
    color: var(--accent);
    margin-top: auto;
    opacity: 0;
    transform: translateX(-6px);
    transition: all 0.25s ease;
  }

  .bento-item:hover .bento-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .bento-item:hover h3 {
    color: var(--accent);
  }

  /* Tech strip - Notion tag-like */
  .tech-strip {
    margin-top: 2.5rem;
    padding: 1.5rem 0;
  }

  .strip-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--bg-secondary);
    border-radius: var(--radius);
    border: 1px solid var(--border-subtle);
  }

  .strip-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .strip-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .strip-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.65rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 0.375rem;
    color: var(--text-secondary);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      padding: 2.5rem 0;
    }

    .hero-content {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .hero-badge {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-desc {
      max-width: 100%;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-image {
      order: -1;
    }

    .image-frame {
      width: 200px;
      height: 200px;
      margin: 0 auto;
    }

    .image-glow {
      width: 220px;
      height: 220px;
    }

    .bento-grid {
      grid-template-columns: 1fr;
    }

    .strip-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
