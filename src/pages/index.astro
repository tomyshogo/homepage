---
import Layout from "../layouts/Layout.astro";
import SplitText from "../components/SplitText.astro";
import { Image } from "astro:assets";
import selfie from "../assets/IMG_4381.jpg";

const pageTitle = "tomy | Software Engineer";

const roles = ["Software Engineer", "IoT Builder", "Game Developer", "Freelancer"];

const techStack = [
  "JavaScript", "TypeScript", "C#", "Python", "Java", "Swift",
  "React", "Vue", "Node.js", "AWS", "Firebase", "Unity",
  "PostgreSQL", "Oracle", "SQLite",
];

// Split the marquee into two rows that scroll in opposite directions.
const half = Math.ceil(techStack.length / 2);
const rowA = techStack.slice(0, half);
const rowB = techStack.slice(half);

const stats = [
  { value: techStack.length, suffix: "+", label: "Technologies" },
  { value: 6, suffix: "", label: "Domains" },
  { value: 2, suffix: "", label: "Live Projects" },
];

const cards = [
  {
    num: "01",
    title: "About",
    desc: "スキル・経歴・これまでの歩み",
    href: "/about/",
    arrow: "→",
    external: false,
    accent: "violet",
    icon: `<path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/>`,
  },
  {
    num: "02",
    title: "Works",
    desc: "個人で作っているプロダクト",
    href: "/works/",
    arrow: "→",
    external: false,
    accent: "teal",
    icon: `<path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/>`,
  },
  {
    num: "03",
    title: "GitHub",
    desc: "オープンソースでの活動",
    href: "https://github.com/tomyshogo",
    arrow: "↗",
    external: true,
    accent: "pink",
    icon: `<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.4.5-.7 1.1-.8 1.7-.1.6-.1 1.2 0 1.8v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>`,
  },
];

// Latest writing, newest first.
const allPosts = await Astro.glob("./posts/*.md");
const latestPosts = allPosts
  .sort((a, b) =>
    String(b.frontmatter.pubDate ?? "").localeCompare(String(a.frontmatter.pubDate ?? ""))
  )
  .slice(0, 3);
---

<Layout title={pageTitle}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-text">
        <div class="hero-badge reveal">
          <span class="badge-dot"></span>
          <span>Available for work</span>
        </div>

        <h1 class="hero-title reveal reveal-chars">
          <span class="title-line">
            <SplitText text="Hi, I'm" />
          </span>
          <span class="title-line"
            ><span class="gradient-text name"><SplitText text="tomy" offset={7} /></span
            ><span class="serif wave" aria-hidden="true">.</span></span
          >
        </h1>

        <div class="role-rotator reveal reveal-delay-2" aria-label={roles.join(", ")}>
          <span class="role-prompt">$</span>
          <span class="role-window">
            {roles.map((role, i) => (
              <span class="role-word" style={`--i: ${i}; --total: ${roles.length}`}>{role}</span>
            ))}
          </span>
          <span class="role-caret" aria-hidden="true"></span>
        </div>

        <p class="hero-desc reveal reveal-delay-3">
          テクノロジー、プログラミング、デザインに情熱を持つソフトウェアエンジニア。
          IoTプロダクトやゲーム開発にも興味を持ち、幅広い技術スタックで開発に取り組んでいます。
        </p>

        <div class="hero-actions reveal reveal-delay-4">
          <a href="/about/" class="btn btn-solid" data-magnetic="0.22">
            About Me <span class="btn-arrow">→</span>
          </a>
          <a href="/works/" class="btn btn-outline" data-magnetic="0.18">
            View Works
          </a>
        </div>
      </div>

      <div class="hero-visual reveal reveal-delay-2 reveal-scale">
        <div class="portrait-stage" data-tilt="10">
          <div class="orbit-ring" aria-hidden="true"></div>
          <div class="portrait-glow" aria-hidden="true"></div>
          <div class="portrait-frame">
            <Image
              src={selfie}
              alt="tomy - Software Engineer"
              width={520}
              height={520}
              class="portrait"
            />
            <div class="portrait-sheen" aria-hidden="true"></div>
          </div>
          <div class="floating-chip chip-a" aria-hidden="true">
            <span class="chip-dot"></span> Freelance
          </div>
          <div class="floating-chip chip-b" aria-hidden="true">Chiba, JP</div>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="stats reveal reveal-delay-5" data-stagger="0.1">
      {stats.map((stat) => (
        <div class="stat">
          <div class="stat-value">
            <span data-count={stat.value}>0</span><span class="stat-suffix">{stat.suffix}</span>
          </div>
          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>

    <a href="#stack" class="scroll-cue reveal reveal-delay-5" aria-label="Scroll down">
      <span class="cue-track"><span class="cue-dot"></span></span>
      <span class="cue-text">Scroll</span>
    </a>
  </section>

  <!-- ============ TECH MARQUEE ============ -->
  <section class="stack-section" id="stack">
    <div class="section-head reveal">
      <span class="mono-label">Tech Stack</span>
      <h2>使っている<span class="serif"> technologies</span></h2>
    </div>

    <div class="marquee stack-marquee reveal reveal-delay-1" aria-hidden="true">
      <div class="marquee-fade marquee-fade-left"></div>
      <div class="marquee-track" style="--marquee-duration: 34s">
        {[0, 1, 2, 3].map(() => (
          <div class="marquee-group">
            {rowA.map((tech) => (
              <span class="stack-pill"><span class="pill-dot"></span>{tech}</span>
            ))}
          </div>
        ))}
      </div>
      <div class="marquee-fade marquee-fade-right"></div>
    </div>

    <div class="marquee stack-marquee reveal reveal-delay-2" aria-hidden="true">
      <div class="marquee-fade marquee-fade-left"></div>
      <div class="marquee-track reverse" style="--marquee-duration: 40s">
        {[0, 1, 2, 3].map(() => (
          <div class="marquee-group">
            {rowB.map((tech) => (
              <span class="stack-pill"><span class="pill-dot"></span>{tech}</span>
            ))}
          </div>
        ))}
      </div>
      <div class="marquee-fade marquee-fade-right"></div>
    </div>

    <p class="sr-only">{techStack.join(", ")}</p>
  </section>

  <!-- ============ EXPLORE CARDS ============ -->
  <section class="explore">
    <div class="section-head reveal">
      <span class="mono-label">Explore</span>
      <h2>もっと<span class="serif"> knowing</span> me</h2>
    </div>

    <div class="card-grid" data-stagger="0.09">
      {cards.map((card) => (
        <a
          href={card.href}
          class:list={["explore-card", "glow-card", "reveal", `accent-${card.accent}`]}
          target={card.external ? "_blank" : undefined}
          rel={card.external ? "noopener noreferrer" : undefined}
        >
          <div class="card-top">
            <span class="card-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none"
                stroke="currentColor" stroke-width="1.8"
                stroke-linecap="round" stroke-linejoin="round" set:html={card.icon} />
            </span>
            <span class="card-num">{card.num}</span>
          </div>
          <div class="card-body">
            <h3>{card.title}</h3>
            <p>{card.desc}</p>
          </div>
          <span class="card-cta">
            <span class="cta-text">{card.external ? "Visit" : "Open"}</span>
            <span class="cta-arrow">{card.arrow}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ============ LATEST WRITING ============ -->
  {latestPosts.length > 0 && (
    <section class="latest">
      <div class="latest-head reveal">
        <div>
          <span class="mono-label">Writing</span>
          <h2>最近の<span class="serif"> notes</span></h2>
        </div>
        <a href="/blog/" class="latest-all">
          All posts <span class="btn-arrow">→</span>
        </a>
      </div>

      <ul class="latest-list" data-stagger="0.08">
        {latestPosts.map((post, i) => (
          <li class="reveal">
            <a href={post.url} class="latest-item">
              <span class="latest-index">{String(i + 1).padStart(2, "0")}</span>
              <span class="latest-main">
                <span class="latest-title">{post.frontmatter.title}</span>
                {post.frontmatter.description && (
                  <span class="latest-desc">{post.frontmatter.description}</span>
                )}
              </span>
              <span class="latest-meta">
                <time>{String(post.frontmatter.pubDate ?? "").slice(0, 10)}</time>
                <span class="latest-arrow">→</span>
              </span>
              <span class="latest-line" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- ============ CTA ============ -->
  <section class="cta reveal reveal-blur">
    <div class="cta-inner glow-card">
      <div class="cta-orb" aria-hidden="true"></div>
      <span class="mono-label">Get in touch</span>
      <h2 class="cta-title">
        一緒に<span class="serif"> something</span> つくりませんか
      </h2>
      <p class="cta-desc">
        新しいプロジェクトのご相談、技術的な雑談、なんでもお気軽にどうぞ。
      </p>
      <div class="cta-actions">
        <a
          href="https://github.com/tomyshogo"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-solid"
          data-magnetic="0.22"
        >
          GitHub <span class="btn-arrow">↗</span>
        </a>
        <a href="/about/" class="btn btn-outline" data-magnetic="0.18">Profile</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ============ HERO ============ */
  .hero {
    padding: 4.5rem 0 3rem;
    position: relative;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.95rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 2rem;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .badge-dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 10px rgba(74, 222, 128, 0.7);
  }

  /* Radar ping */
  .badge-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #4ade80;
    animation: ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    0% { transform: scale(1); opacity: 0.7; }
    80%, 100% { transform: scale(3.2); opacity: 0; }
  }

  .hero-title {
    margin: 0 0 1.25rem;
  }

  .title-line {
    display: block;
  }

  .name {
    display: inline-block;
  }

  .wave {
    display: inline-block;
    color: var(--accent);
    transform-origin: 70% 80%;
    animation: wave 3.2s ease-in-out infinite;
  }

  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    70% { transform: rotate(-14deg); }
    80% { transform: rotate(10deg); }
    90% { transform: rotate(-6deg); }
  }

  /* Rotating role line */
  .role-rotator {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    height: 1.7em;
  }

  .role-prompt {
    color: var(--accent);
    font-weight: 600;
  }

  .role-window {
    position: relative;
    display: inline-block;
    height: 1.7em;
    min-width: 19ch;
    overflow: hidden;
  }

  .role-word {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    white-space: nowrap;
    color: var(--accent-2);
    opacity: 0;
    transform: translateY(110%);
    animation: role-cycle calc(var(--total) * 3s) infinite;
    animation-delay: calc(var(--i) * 3s);
  }

  @keyframes role-cycle {
    0% { opacity: 0; transform: translateY(110%); }
    3%, 22% { opacity: 1; transform: translateY(0); }
    25%, 100% { opacity: 0; transform: translateY(-110%); }
  }

  .role-caret {
    width: 8px;
    height: 1.15em;
    background: var(--accent-2);
    opacity: 0.75;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero-desc {
    max-width: 44ch;
    font-size: 1rem;
    line-height: 1.9;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* ---- Portrait ---- */
  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .portrait-stage {
    position: relative;
    width: 300px;
    height: 300px;
    transform-style: preserve-3d;
    transition: transform 0.5s var(--ease-out-expo);
    animation: float 7s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -14px; }
  }

  .orbit-ring {
    position: absolute;
    inset: -16px;
    border-radius: calc(var(--radius-lg) + 16px);
    background: conic-gradient(
      from var(--ring-angle, 0deg),
      transparent 0%,
      rgba(167, 139, 250, 0.8) 10%,
      rgba(45, 212, 191, 0.6) 22%,
      transparent 38%
    );
    filter: blur(14px);
    opacity: 0.85;
    animation: spin-ring 6s linear infinite;
  }

  @property --ring-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  @keyframes spin-ring {
    to { --ring-angle: 360deg; }
  }

  .portrait-glow {
    position: absolute;
    inset: -40px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.28) 0%, transparent 68%);
    filter: blur(36px);
  }

  .portrait-frame {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-medium);
    box-shadow: var(--shadow-lg);
    transform: translateZ(40px);
  }

  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-out-expo);
  }

  .portrait-stage:hover .portrait {
    transform: scale(1.06);
  }

  /* Diagonal light sweep across the photo */
  .portrait-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 35%,
      rgba(255, 255, 255, 0.14) 48%,
      transparent 60%
    );
    background-size: 260% 260%;
    animation: sheen 6s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes sheen {
    0%, 65% { background-position: 130% 0; }
    100% { background-position: -30% 0; }
  }

  .floating-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border-radius: 2rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: rgba(14, 14, 21, 0.86);
    border: 1px solid var(--border-medium);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-md);
    transform: translateZ(70px);
    white-space: nowrap;
  }

  .chip-a {
    top: 14%;
    left: -46px;
    animation: bob 5s ease-in-out infinite;
  }

  .chip-b {
    bottom: 16%;
    right: -38px;
    animation: bob 5s ease-in-out 1.4s infinite;
  }

  @keyframes bob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -9px; }
  }

  .chip-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow: 0 0 8px var(--accent-2);
  }

  /* ---- Stats ---- */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 4rem;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .stat {
    padding: 1.5rem 1.75rem;
    background: rgba(8, 8, 12, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: background 0.35s var(--ease-smooth);
  }

  .stat:hover {
    background: rgba(167, 139, 250, 0.05);
  }

  .stat-value {
    font-size: clamp(1.75rem, 3.5vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    background: var(--gradient-brand);
    background-size: 250% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradient-flow 7s linear infinite;
  }

  .stat-suffix {
    font-size: 0.65em;
  }

  .stat-label {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  /* ---- Scroll cue ---- */
  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-muted);
  }

  .scroll-cue:hover { color: var(--accent); }

  .cue-track {
    position: relative;
    width: 20px;
    height: 32px;
    border: 1px solid var(--border-medium);
    border-radius: 12px;
  }

  .cue-dot {
    position: absolute;
    top: 6px;
    left: 50%;
    width: 3px;
    height: 6px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--accent);
    animation: cue-drop 1.8s var(--ease-out-expo) infinite;
  }

  @keyframes cue-drop {
    0% { transform: translateY(0); opacity: 0; }
    30% { opacity: 1; }
    70% { transform: translateY(12px); opacity: 0; }
    100% { opacity: 0; }
  }

  /* ============ STACK ============ */
  .stack-section {
    padding: 3.5rem 0 2.5rem;
    scroll-margin-top: 90px;
  }

  .stack-marquee {
    padding: 0.5rem 0;
    margin: 0 -2rem;
  }

  .stack-marquee + .stack-marquee {
    margin-top: 0.75rem;
  }

  .marquee-group {
    display: flex;
    flex-shrink: 0;
  }

  .stack-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0.4rem;
    padding: 0.55rem 1.1rem;
    border-radius: 2rem;
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
    transition: all 0.3s var(--ease-smooth);
  }

  .stack-pill:hover {
    color: var(--text-primary);
    border-color: var(--accent-glow-strong);
    background: var(--accent-dim);
  }

  .pill-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.65;
  }

  /* ============ EXPLORE ============ */
  .explore {
    padding: 2.5rem 0 3.5rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .explore-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.75rem;
    min-height: 196px;
    text-decoration: none;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    transition: all 0.45s var(--ease-spring);
  }

  .explore-card:hover .card-icon {
    transform: translateY(-3px) rotate(-8deg) scale(1.08);
    color: var(--card-accent, var(--accent));
    border-color: var(--card-accent, var(--accent));
    box-shadow: 0 0 24px -6px var(--card-accent, var(--accent));
  }

  .accent-violet { --card-accent: #a78bfa; }
  .accent-teal { --card-accent: #2dd4bf; }
  .accent-pink { --card-accent: #f472b6; }

  .card-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    transition: color 0.3s ease;
  }

  .explore-card:hover .card-num { color: var(--card-accent); }

  .card-body {
    margin-top: auto;
  }

  .explore-card h3 {
