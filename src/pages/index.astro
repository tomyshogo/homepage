---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import selfie from "../assets/IMG_4381.jpg";

const pageTitle = "tomy | Software Engineer";
---

<Layout title={pageTitle}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <p class="mono-label reveal">Software Engineer</p>
        <h1 class="hero-title reveal reveal-delay-1">
          Hi, I'm <span class="accent">tomy</span>
        </h1>
        <p class="hero-desc reveal reveal-delay-2">
          テクノロジー、プログラミング、デザインに情熱を持つソフトウェアエンジニア。
          IoTプロダクトやゲーム開発にも興味を持ち、幅広い技術スタックで開発に取り組んでいます。
        </p>
        <div class="hero-actions reveal reveal-delay-3">
          <a href="/about/" class="btn-primary">About Me</a>
          <a href="/works/" class="btn-secondary">Works</a>
        </div>
      </div>
      <div class="hero-image reveal reveal-delay-2">
        <div class="image-frame">
          <Image
            src={selfie}
            alt="tomy - Software Engineer"
            width={400}
            height={400}
            class="portrait"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Status Section -->
  <section class="status reveal reveal-delay-4">
    <div class="status-card">
      <span class="status-dot"></span>
      <span class="status-text">Available for freelance work</span>
    </div>
  </section>

  <!-- Quick Links -->
  <section class="quick-links reveal reveal-delay-5">
    <div class="link-grid">
      <a href="/about/" class="quick-card glass">
        <span class="card-icon">01</span>
        <h3>About</h3>
        <p>スキル・経歴について</p>
        <span class="card-arrow">&rarr;</span>
      </a>
      <a href="/works/" class="quick-card glass">
        <span class="card-icon">02</span>
        <h3>Works</h3>
        <p>ブログ・活動記録</p>
        <span class="card-arrow">&rarr;</span>
      </a>
      <a href="https://github.com/tomyshogo" target="_blank" rel="noopener noreferrer" class="quick-card glass">
        <span class="card-icon">03</span>
        <h3>GitHub</h3>
        <p>オープンソース活動</p>
        <span class="card-arrow">&rarr;</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: 5rem 0 3rem;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }

  .hero-title {
    margin: 0.75rem 0 1.25rem;
  }

  .accent {
    color: var(--accent);
    position: relative;
  }

  .accent::after {
    content: "";
    position: absolute;
    bottom: 2px;
    left: 0;
    right: 0;
    height: 8px;
    background: var(--accent-dim);
    border-radius: 2px;
    z-index: -1;
  }

  .hero-desc {
    max-width: 480px;
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }

  .btn-primary {
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.75rem 1.75rem;
    background: var(--accent);
    color: #ffffff;
    border-radius: 0.75rem;
    transition: all 0.3s var(--ease-out-expo);
    box-shadow: 0 2px 8px rgba(99, 102, 241, 0.25);
  }

  .btn-primary:hover {
    background: #4f46e5;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(99, 102, 241, 0.35);
  }

  .btn-secondary {
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.75rem 1.75rem;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    border-radius: 0.75rem;
    transition: all 0.3s var(--ease-out-expo);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
    background: var(--accent-dim);
  }

  /* Portrait */
  .hero-image {
    position: relative;
  }

  .image-frame {
    position: relative;
    width: 280px;
    height: 280px;
    border-radius: 2rem;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 2rem;
    transition: transform 0.5s ease;
  }

  .image-frame:hover .portrait {
    transform: scale(1.03);
  }

  /* Status */
  .status {
    margin: 2rem 0 3rem;
  }

  .status-card {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1.25rem;
    border-radius: 2rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.4);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .status-text {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  /* Quick Links */
  .link-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .quick-card {
    padding: 1.75rem;
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: all 0.4s var(--ease-out-expo);
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .quick-card:hover {
    transform: translateY(-4px);
  }

  .card-icon {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    opacity: 0.5;
  }

  .quick-card h3 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .quick-card p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .card-arrow {
    font-size: 1.2rem;
    color: var(--accent);
    margin-top: auto;
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.3s var(--ease-out-expo);
  }

  .quick-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      padding: 2rem 0;
    }

    .hero-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
    }

    .hero-desc {
      max-width: 100%;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-image {
      order: -1;
    }

    .image-frame {
      width: 200px;
      height: 200px;
      margin: 0 auto;
    }

    .link-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
