---
import Layout from "../layouts/Layout.astro";
import SplitText from "../components/SplitText.astro";

const projects = [
  {
    name: "homepage",
    description: "このポートフォリオサイト。Astro + TypeScript で構築し、モーションデザインにこだわった。",
    repo: "https://github.com/tomyshogo/homepage",
    tags: ["Astro", "TypeScript", "CSS"],
    year: "2024",
    accent: "violet",
  },
  {
    name: "life",
    description: "毎朝の「おはよう」から始まる思考整理・ライフログ。書いたものはこのサイトに同期される。",
    repo: "https://github.com/tomyshogo/life",
    tags: ["Markdown", "Life"],
    year: "2024",
    accent: "teal",
  },
];

const pageTitle = "tomy | works";
---

<Layout title={pageTitle}>
  <section class="page-head">
    <span class="mono-label reveal">Projects</span>
    <h1 class="reveal reveal-chars">
      <SplitText text="Works" />
    </h1>
    <p class="page-desc reveal reveal-delay-2">
      個人で手を動かして作っているプロジェクト。全部オープンソースです。
    </p>
  </section>

  <div class="project-list" data-stagger="0.12">
    {projects.map((project, i) => (
      <a
        href={project.repo}
        target="_blank"
        rel="noopener noreferrer"
        class:list={["project-card", "glow-card", "reveal", `accent-${project.accent}`]}
      >
        <span class="project-glyph" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>

        <div class="project-main">
          <div class="project-top">
            <h3 class="project-name">{project.name}</h3>
            <span class="project-year">{project.year}</span>
          </div>

          <p class="project-desc">{project.description}</p>

          <div class="project-foot">
            <div class="project-tags">
              {project.tags.map((tag) => (
                <span class="project-tag">{tag}</span>
              ))}
            </div>
            <span class="project-link">
              View on GitHub
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </span>
          </div>
        </div>

        <span class="project-edge" aria-hidden="true"></span>
      </a>
    ))}
  </div>

  <section class="more reveal reveal-blur">
    <div class="more-inner glass">
      <span class="more-pulse" aria-hidden="true"></span>
      <div>
        <h3>More coming soon</h3>
        <p>IoT とゲーム開発まわりで、いま仕込み中のものがあります。</p>
      </div>
      <a href="https://github.com/tomyshogo" target="_blank" rel="noopener noreferrer" class="more-link">
        Follow on GitHub <span class="btn-arrow">↗</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .project-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.75rem;
    padding: 2rem 2rem 1.85rem;
    text-decoration: none;
  }

  .accent-violet { --card-accent: #a78bfa; }
  .accent-teal { --card-accent: #2dd4bf; }

  /* Oversized ghost index */
  .project-glyph {
    font-family: var(--font-mono);
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px var(--border-medium);
    transition: all 0.5s var(--ease-out-expo);
  }

  .project-card:hover .project-glyph {
    -webkit-text-stroke-color: var(--card-accent);
    transform: translateY(-4px);
  }

  .project-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-name {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    transition: color 0.3s ease;
  }

  .project-card:hover .project-name { color: var(--card-accent); }

  .project-year {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
  }

  .project-desc {
    margin-top: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.75;
    max-width: 60ch;
  }

  .project-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    padding: 0.25rem 0.65rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 0.35rem;
    color: var(--text-muted);
    transition: all 0.35s var(--ease-smooth);
  }

  .project-card:hover .project-tag {
    color: var(--text-secondary);
    border-color: var(--border-medium);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--card-accent);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.45s var(--ease-out-expo);
  }

  .project-card:hover .project-link {
    opacity: 1;
    transform: none;
  }

  /* Left edge accent */
  .project-edge {
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 0;
    border-radius: 0 3px 3px 0;
    background: var(--card-accent);
    box-shadow: 0 0 16px var(--card-accent);
    transform: translateY(-50%);
    transition: height 0.5s var(--ease-out-expo);
  }

  .project-card:hover .project-edge { height: 55%; }

  /* More section */
  .more {
    margin-top: 3rem;
  }

  .more-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.75rem 2rem;
    border-radius: var(--radius);
    border-style: dashed;
  }

  .more-pulse {
    position: relative;
    flex-shrink: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }

  .more-pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: ping-slow 2.6s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping-slow {
    0% { transform: scale(1); opacity: 0.6; }
    80%, 100% { transform: scale(3.4); opacity: 0; }
  }

  .more-inner h3 {
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .more-inner p {
    margin-top: 0.15rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .more-link {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .more-link:hover { color: var(--accent); }
  .more-link:hover .btn-arrow { transform: translateX(4px); }

  @media (max-width: 640px) {
    .project-card {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 1.5rem;
    }

    .project-glyph { font-size: 1.75rem; }

    .project-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }

    .project-link { opacity: 1; transform: none; }

    .more-inner {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }

    .more-link { margin-left: 0; }
  }
</style>
