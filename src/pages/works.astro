---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    name: "homepage",
    description: "このポートフォリオサイト。Astro + TypeScript で構築。",
    repo: "https://github.com/tomyshogo/homepage",
    tags: ["Astro", "TypeScript", "CSS"],
  },
  {
    name: "life",
    description: "毎朝の「おはよう」から始まる思考整理・ライフログ。",
    repo: "https://github.com/tomyshogo/life",
    tags: ["Markdown", "Life"],
  },
];

const pageTitle = "tomy | works";
---

<Layout title={pageTitle}>
  <section class="works-header reveal">
    <p class="mono-label">Projects</p>
    <h1>Works</h1>
    <p class="works-desc">個人で取り組んでいるプロジェクト</p>
  </section>

  <div class="project-grid reveal reveal-delay-1">
    {projects.map((project) => (
      <a href={project.repo} target="_blank" rel="noopener noreferrer" class="project-card glow-card">
        <div class="project-header">
          <h3 class="project-name">{project.name}</h3>
          <svg class="external-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7" />
            <path d="M7 7h10v10" />
          </svg>
        </div>
        <p class="project-desc">{project.description}</p>
        <div class="project-tags">
          {project.tags.map((tag) => (
            <span class="project-tag">{tag}</span>
          ))}
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .works-header {
    padding: 3rem 0 1rem;
  }

  .works-header h1 {
    margin: 0.5rem 0 0.5rem;
  }

  .works-desc {
    color: var(--text-secondary);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .project-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: color 0.15s ease;
  }

  .external-icon {
    color: var(--text-muted);
    opacity: 0;
    transform: translate(-2px, 2px);
    transition: all 0.2s ease;
  }

  .project-card:hover .project-name {
    color: var(--accent);
  }

  .project-card:hover .external-icon {
    opacity: 1;
    color: var(--accent);
    transform: translate(0, 0);
  }

  .project-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 0.3rem;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .works-header {
      padding: 2rem 0 0.5rem;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
