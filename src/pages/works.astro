---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    name: "homepage",
    description: "このポートフォリオサイト。Astro + TypeScript で構築。",
    repo: "https://github.com/tomyshogo/homepage",
    tags: ["Astro", "TypeScript", "CSS"],
  },
  {
    name: "life",
    description: "毎朝の「おはよう」から始まる思考整理・ライフログ。",
    repo: "https://github.com/tomyshogo/life",
    tags: ["Markdown", "Life"],
  },
];

const pageTitle = "tomy | works";
---

<Layout title={pageTitle}>
  <section class="works-header reveal">
    <p class="mono-label">Projects</p>
    <h1>Works</h1>
    <p class="works-desc">個人で取り組んでいるプロジェクト</p>
  </section>

  <div class="project-list">
    {projects.map((project, i) => (
      <a
        href={project.repo}
        target="_blank"
        rel="noopener noreferrer"
        class={`project-card glow-card reveal reveal-delay-${i + 1}`}
      >
        <div class="project-index">
          <span class="index-num">{String(i + 1).padStart(2, "0")}</span>
        </div>
        <div class="project-body">
          <div class="project-header">
            <h3 class="project-name">{project.name}</h3>
            <svg class="external-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7" />
              <path d="M7 7h10v10" />
            </svg>
          </div>
          <p class="project-desc">{project.description}</p>
          <div class="project-meta">
            <div class="project-tags">
              {project.tags.map((tag) => (
                <span class="project-tag">{tag}</span>
              ))}
            </div>
            <span class="project-link-text">View on GitHub</span>
          </div>
        </div>
        <div class="card-accent-line"></div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .works-header {
    padding: 3rem 0 1.5rem;
  }

  .works-header h1 {
    margin: 0.5rem 0 0.5rem;
  }

  .works-desc {
    color: var(--text-secondary);
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }

  .project-card {
    display: flex;
    align-items: stretch;
    text-decoration: none;
    overflow: hidden;
    position: relative;
    transition: all 0.25s ease;
  }

  .card-accent-line {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    opacity: 0;
    transform: scaleY(0);
    transform-origin: center;
    transition: all 0.3s var(--ease-out-expo);
    border-radius: 0 2px 2px 0;
  }

  .project-card:hover .card-accent-line {
    opacity: 1;
    transform: scaleY(1);
  }

  .project-index {
    display: flex;
    align-items: flex-start;
    padding: 1.75rem 0 1.75rem 1.75rem;
    flex-shrink: 0;
  }

  .index-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    transition: color 0.2s ease;
  }

  .project-card:hover .index-num {
    color: var(--accent);
  }

  .project-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem 1.75rem 1.75rem 1.25rem;
    min-width: 0;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .project-name {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }

  .external-icon {
    color: var(--text-muted);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: all 0.25s var(--ease-out-expo);
    flex-shrink: 0;
  }

  .project-card:hover .project-name {
    color: var(--accent);
  }

  .project-card:hover .external-icon {
    opacity: 1;
    color: var(--accent);
    transform: translate(0, 0);
  }

  .project-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 0.3rem;
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }

  .project-card:hover .project-tag {
    border-color: var(--accent-glow);
    background: var(--accent-dim);
    color: var(--accent);
  }

  .project-link-text {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.25s var(--ease-out-expo);
    white-space: nowrap;
  }

  .project-card:hover .project-link-text {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 768px) {
    .works-header {
      padding: 2rem 0 1rem;
    }

    .project-index {
      padding: 1.25rem 0 1.25rem 1.25rem;
    }

    .project-body {
      padding: 1.25rem 1.25rem 1.25rem 1rem;
    }

    .project-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .project-link-text {
      display: none;
    }
  }
</style>
