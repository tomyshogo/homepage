---
import Layout from "../layouts/Layout.astro";
import BlogPost from "../components/BlogPost.astro";

const allPosts = await Astro.glob("../pages/posts/*.md");
const pageTitle = "tomy | works";
---

<Layout title={pageTitle}>
  <section class="works-header reveal">
    <p class="mono-label">Blog & Activity</p>
    <h1>Works</h1>
    <p class="works-desc">ブログ記事や活動の記録</p>
  </section>

  <div class="works-controls reveal reveal-delay-1">
    <a href="/tags/" class="tags-link glass">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 5 6.3 6.3a2.4 2.4 0 0 1 0 3.4L12 24"/>
        <path d="M9.586 5.586A2 2 0 0 0 8.172 5H3a1 1 0 0 1-1-1V1a1 1 0 0 1 1-1h3.172a2 2 0 0 1 1.414.586L15 8"/>
        <circle cx="6.5" cy="1.5" r=".5" fill="currentColor"/>
      </svg>
      All Tags
    </a>
    <div class="select-wrapper">
      <select id="post-sort">
        <option value="latest">New &rarr; Old</option>
        <option value="oldest">Old &rarr; New</option>
      </select>
    </div>
  </div>

  <ul class="post-grid reveal reveal-delay-2" id="post-list">
    {allPosts.reverse().map((post) => <BlogPost post={post} />)}
  </ul>
</Layout>

<style>
  .works-header {
    padding: 3rem 0 1rem;
  }

  .works-header h1 {
    margin: 0.5rem 0 0.5rem;
  }

  .works-desc {
    color: var(--text-secondary);
  }

  .works-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 1.5rem 0;
  }

  .tags-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.3s ease;
  }

  .tags-link:hover {
    color: var(--accent);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
  }

  @media (max-width: 768px) {
    .works-header {
      padding: 2rem 0 0.5rem;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const postSortSelect = document.getElementById("post-sort") as HTMLSelectElement;
  const postList = document.getElementById("post-list");

  postSortSelect?.addEventListener("change", () => {
    if (!postList) return;
    const items = Array.from(postList.children);
    items.reverse();
    postList.innerHTML = "";
    items.forEach((item) => postList.appendChild(item));
  });
</script>
