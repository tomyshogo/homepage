---
import Layout from "../layouts/Layout.astro";
import SplitText from "../components/SplitText.astro";
import { Image } from "astro:assets";
import selfie from "../assets/IMG_4381.jpg";

const pageTitle = "tomy | about";

const sns = [
  {
    name: "GitHub",
    url: "https://github.com/tomyshogo",
    icon: "https://cdn.svgporn.com/logos/github-icon.svg",
  },
];

const LEVEL_VALUE: Record<string, number> = {
  Advanced: 90,
  Intermediate: 62,
  Beginner: 34,
};

const skills = [
  {
    category: "Frontend",
    icon: `<path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M9 21V9"/>`,
    items: [
      { name: "JavaScript", level: "Advanced", icon: "https://cdn.svgporn.com/logos/javascript.svg" },
      { name: "React", level: "Beginner", icon: "https://cdn.svgporn.com/logos/react.svg" },
      { name: "Vue", level: "Beginner", icon: "https://cdn.svgporn.com/logos/vue.svg" },
    ],
  },
  {
    category: "Backend",
    icon: `<rect width="20" height="8" x="2" y="2" rx="2"/><rect width="20" height="8" x="2" y="14" rx="2"/><path d="M6 6h.01M6 18h.01"/>`,
    items: [
      { name: "C#", level: "Advanced", icon: "https://cdn.svgporn.com/logos/c-sharp.svg" },
      { name: "Python", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/python.svg" },
      { name: "Java", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/java.svg" },
      { name: "TypeScript", level: "Beginner", icon: "https://cdn.svgporn.com/logos/typescript-icon.svg" },
      { name: "Node.js", level: "Beginner", icon: "https://cdn.svgporn.com/logos/nodejs.svg" },
    ],
  },
  {
    category: "Mobile",
    icon: `<rect width="14" height="20" x="5" y="2" rx="2"/><path d="M12 18h.01"/>`,
    items: [
      { name: "Swift", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/swift.svg" },
    ],
  },
  {
    category: "Infrastructure",
    icon: `<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>`,
    items: [
      { name: "AWS", level: "Advanced", icon: "https://cdn.svgporn.com/logos/aws.svg" },
      { name: "Firebase", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/firebase.svg" },
    ],
  },
  {
    category: "Database",
    icon: `<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>`,
    items: [
      { name: "Oracle", level: "Advanced", icon: "https://cdn.svgporn.com/logos/oracle.svg" },
      { name: "PostgreSQL", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/postgresql.svg" },
      { name: "SQLite", level: "Beginner", icon: "https://cdn.svgporn.com/logos/sqlite.svg" },
    ],
  },
  {
    category: "Game Dev",
    icon: `<line x1="6" x2="10" y1="11" y2="11"/><line x1="8" x2="8" y1="9" y2="13"/><line x1="15" x2="15.01" y1="12" y2="12"/><line x1="18" x2="18.01" y1="10" y2="10"/><rect width="20" height="12" x="2" y="6" rx="6"/>`,
    items: [
      { name: "Unity", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/unity.svg" },
    ],
  },
];

const levelClass = (level: string) =>
  ({
    Advanced: "level-advanced",
    Intermediate: "level-intermediate",
    Beginner: "level-beginner",
  })[level] ?? "";

const interests = [
  {
    title: "Game Development",
    desc: "Unity を使ったゲーム開発。手を動かしながら physics と shader を勉強中。",
    icon: `<line x1="6" x2="10" y1="11" y2="11"/><line x1="8" x2="8" y1="9" y2="13"/><line x1="15" x2="15.01" y1="12" y2="12"/><line x1="18" x2="18.01" y1="10" y2="10"/><rect width="20" height="12" x="2" y="6" rx="6"/>`,
    accent: "violet",
  },
  {
    title: "IoT Product",
    desc: "IoT プロダクトの設計と開発。ハードとソフトの境目にあるものが好き。",
    icon: `<path d="M12 20h.01"/><path d="M8.5 16.4a5 5 0 0 1 7 0"/><path d="M5 12.9a10 10 0 0 1 14 0"/><path d="M1.4 9.4a15 15 0 0 1 21.2 0"/>`,
    accent: "teal",
  },
];
---

<Layout title={pageTitle}>
  <!-- ============ PROFILE ============ -->
  <section class="profile">
    <div class="profile-layout">
      <div class="profile-visual reveal reveal-scale">
        <div class="avatar-stage" data-tilt="9">
          <span class="avatar-ring" aria-hidden="true"></span>
          <span class="avatar-glow" aria-hidden="true"></span>
          <Image
            src={selfie}
            alt="冨谷 彰吾"
            width={320}
            height={320}
            class="avatar"
          />
        </div>
      </div>

      <div class="profile-info">
        <span class="mono-label reveal">Profile</span>
        <h1 class="profile-name reveal reveal-chars">
          <SplitText text="冨谷 彰吾" />
        </h1>
        <p class="profile-role reveal reveal-delay-2">
          Software Engineer <span class="role-sep">/</span> <span class="serif">Freelance</span>
        </p>
        <p class="profile-bio reveal reveal-delay-3">
          千葉県在住。新卒から未経験で SES 企業に入社し、現在はフリーランスエンジニアとして活動中。
        </p>

        <div class="profile-links reveal reveal-delay-4">
          {sns.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="sns-chip" data-magnetic="0.16">
              <img src={s.icon} alt="" width="15" height="15" loading="lazy" />
              {s.name}
              <span class="btn-arrow">↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <hr />

  <!-- ============ GITHUB ============ -->
  <section class="github-section">
    <div class="section-head reveal">
      <span class="mono-label">GitHub Activity</span>
      <h2>Stats &amp;<span class="serif"> contributions</span></h2>
    </div>

    <div class="stats-grid" data-stagger="0.1">
      <div class="stat-card notion-block reveal">
        <img
          src="https://github-readme-stats.vercel.app/api?username=tomyshogo&show_icons=true&hide_border=true&title_color=a78bfa&text_color=a3a3b2&icon_color=2dd4bf&bg_color=00000000"
          alt="GitHub Stats"
          loading="lazy"
        />
      </div>
      <div class="stat-card notion-block reveal">
        <img
          src="https://github-readme-stats.vercel.app/api/top-langs/?username=tomyshogo&langs_count=5&hide=html,cmake&hide_border=true&title_color=a78bfa&text_color=a3a3b2&bg_color=00000000&layout=compact"
          alt="Top Languages"
          loading="lazy"
        />
      </div>
    </div>

    <div class="stat-wide notion-block reveal reveal-delay-2">
      <img
        src="https://github-profile-summary-cards.vercel.app/api/cards/profile-details?username=tomyshogo&theme=github_dark"
        alt="Profile Summary"
        loading="lazy"
      />
    </div>
  </section>

  <hr />

  <!-- ============ SKILLS ============ -->
  <section class="skills-section">
    <div class="section-head reveal">
      <span class="mono-label">Tech Stack</span>
      <h2>Skills &amp;<span class="serif"> expertise</span></h2>
      <p class="lead">
        普段の仕事と個人開発で触れている技術。バーは自己評価の習熟度です。
      </p>
    </div>

    <div class="legend reveal reveal-delay-1">
      <span class="legend-item"><span class="legend-dot dot-advanced"></span>Advanced</span>
      <span class="legend-item"><span class="legend-dot dot-intermediate"></span>Intermediate</span>
      <span class="legend-item"><span class="legend-dot dot-beginner"></span>Beginner</span>
    </div>

    <div class="skills-grid" data-stagger="0.07">
      {skills.map((group) => (
        <div class="skill-group glow-card reveal">
          <div class="group-head">
            <span class="group-icon">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
                stroke="currentColor" stroke-width="1.8"
                stroke-linecap="round" stroke-linejoin="round" set:html={group.icon} />
            </span>
            <h3 class="group-title">{group.category}</h3>
            <span class="group-count">{group.items.length}</span>
          </div>

          <div class="skill-items">
            {group.items.map((skill) => (
              <div class="skill-item">
                <span class="skill-icon">
                  <img src={skill.icon} alt="" width="18" height="18" loading="lazy" />
                </span>
                <span class="skill-body">
                  <span class="skill-row">
                    <span class="skill-name">{skill.name}</span>
                    <span class={`skill-level ${levelClass(skill.level)}`}>{skill.level}</span>
                  </span>
                  <span class="skill-bar">
                    <span
                      class={`skill-fill ${levelClass(skill.level)}`}
                      data-bar={LEVEL_VALUE[skill.level] ?? 0}
                    ></span>
                  </span>
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <hr />

  <!-- ============ INTERESTS ============ -->
  <section class="interests-section">
    <div class="section-head reveal">
      <span class="mono-label">Interests</span>
      <h2>What I'm<span class="serif"> into</span></h2>
    </div>

    <div class="interests-grid" data-stagger="0.1">
      {interests.map((item) => (
        <div class:list={["interest-card", "glow-card", "reveal", `accent-${item.accent}`]}>
          <span class="interest-icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
              stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
          </span>
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  /* ============ PROFILE ============ */
  .profile {
    padding: 3.5rem 0 1rem;
  }

  .profile-layout {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 3rem;
    align-items: center;
  }

  .avatar-stage {
    position: relative;
    width: 180px;
    height: 180px;
    transition: transform 0.5s var(--ease-out-expo);
  }

  .avatar-ring {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: conic-gradient(
      from var(--avatar-angle, 0deg),
      transparent 0%,
      rgba(167, 139, 250, 0.9) 15%,
      rgba(45, 212, 191, 0.7) 30%,
      transparent 48%
    );
    filter: blur(9px);
    animation: spin-avatar 7s linear infinite;
  }

  @property --avatar-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  @keyframes spin-avatar {
    to { --avatar-angle: 360deg; }
  }

  .avatar-glow {
    position: absolute;
    inset: -26px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.28), transparent 68%);
    filter: blur(26px);
  }

  .avatar {
    position: relative;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border-medium);
    box-shadow: var(--shadow-lg);
  }

  .profile-name {
    margin: 0.5rem 0 0.35rem;
    font-size: clamp(1.9rem, 5vw, 3rem);
  }

  .profile-role {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent-hover);
  }

  .role-sep {
    color: var(--text-faint);
    margin: 0 0.15rem;
  }

  .profile-bio {
    margin-top: 0.9rem;
    max-width: 46ch;
  }

  .profile-links {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .sns-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      transform 0.3s var(--ease-out-expo),
      color 0.3s ease,
      border-color 0.3s ease,
      background 0.3s ease;
  }

  .sns-chip img {
    filter: invert(1) brightness(1.4);
    opacity: 0.85;
  }

  .sns-chip:hover {
    color: var(--accent-hover);
    border-color: var(--accent-glow-strong);
    background: var(--accent-dim);
  }

  .sns-chip:hover .btn-arrow { transform: translateX(3px); }

  /* ============ GITHUB ============ */
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .stat-card,
  .stat-wide {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.35rem;
    overflow: hidden;
  }

  .stat-card img { width: 100%; max-width: 400px; }
  .stat-wide img { width: 100%; max-width: 820px; }

  /* ============ SKILLS ============ */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .legend-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .dot-advanced { background: #a78bfa; box-shadow: 0 0 8px rgba(167, 139, 250, 0.6); }
  .dot-intermediate { background: #60a5fa; box-shadow: 0 0 8px rgba(96, 165, 250, 0.5); }
  .dot-beginner { background: #4ade80; box-shadow: 0 0 8px rgba(74, 222, 128, 0.5); }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .skill-group {
    padding: 1.5rem;
  }

  .group-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-bottom: 0.9rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .group-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    color: var(--accent);
    transition: transform 0.45s var(--ease-spring);
  }

  .skill-group:hover .group-icon {
    transform: rotate(-8deg) scale(1.08);
  }

  .group-title {
    font-size: 0.9rem;
    font-weight: 650;
    color: var(--text-primary);
  }

  .group-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-faint);
  }

  .skill-items {
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
  }

  .skill-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .skill-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.94);
    transition: transform 0.4s var(--ease-spring);
  }

  .skill-item:hover .skill-icon {
    transform: scale(1.12) rotate(-6deg);
  }

  .skill-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .skill-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .skill-name {
    font-size: 0.85rem;
    font-weight: 550;
    color: var(--text-primary);
  }

  .skill-level {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .skill-bar {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: var(--bg-tertiary);
    overflow: hidden;
  }

  .skill-fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 2px;
    transition: width 1.1s var(--ease-out-expo);
  }

  .level-advanced { color: #c4b5fd; }
  .skill-fill.level-advanced { background: linear-gradient(90deg, #7c3aed, #a78bfa); }

  .level-intermediate { color: #93c5fd; }
  .skill-fill.level-intermediate { background: linear-gradient(90deg, #2563eb, #60a5fa); }

  .level-beginner { color: #86efac; }
  .skill-fill.level-beginner { background: linear-gradient(90deg, #16a34a, #4ade80); }

  /* ============ INTERESTS ============ */
  .interests-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .interest-card {
    padding: 2rem;
  }

  .accent-violet { --card-accent: #a78bfa; }
  .accent-teal { --card-accent: #2dd4bf; }

  .interest-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-bottom: 1.1rem;
    border-radius: 13px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    color: var(--card-accent);
    transition: all 0.45s var(--ease-spring);
  }

  .interest-card:hover .interest-icon {
    transform: translateY(-3px) rotate(-8deg) scale(1.07);
    border-color: var(--card-accent);
    box-shadow: 0 0 26px -8px var(--card-accent);
  }

  .interest-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    transition: color 0.3s ease;
  }

  .interest-card:hover h3 { color: var(--card-accent); }

  .interest-card p {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 768px) {
    .profile-layout {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 1.75rem;
    }

    .avatar-stage,
    .avatar {
      width: 140px;
      height: 140px;
    }

    .profile-bio { max-width: 100%; }

    .profile-links { justify-content: center; }

    .stats-grid,
    .skills-grid,
    .interests-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar-ring { animation: none; }
    .skill-fill { transition: none; }
  }
</style>

<script>
  /** Fill skill bars once their group scrolls into view. */
  function initSkillBars() {
    const bars = document.querySelectorAll<HTMLElement>("[data-bar]");
    if (!bars.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          io.unobserve(el);
          el.style.width = `${el.dataset.bar}%`;
        }
      },
      { threshold: 0.4 }
    );

    bars.forEach((bar) => io.observe(bar));
  }

  document.addEventListener("astro:page-load", initSkillBars);
</script>
