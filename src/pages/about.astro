---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import selfie from "../assets/IMG_4381.jpg";

const pageTitle = "tomy | about";

const sns = [
  {
    name: "GitHub",
    url: "https://github.com/tomyshogo",
    icon: "https://cdn.svgporn.com/logos/github-icon.svg",
  },
];

const skills = [
  {
    category: "Frontend",
    items: [
      { name: "JavaScript", level: "Advanced", icon: "https://cdn.svgporn.com/logos/javascript.svg" },
      { name: "React", level: "Beginner", icon: "https://cdn.svgporn.com/logos/react.svg" },
      { name: "Vue", level: "Beginner", icon: "https://cdn.svgporn.com/logos/vue.svg" },
    ],
  },
  {
    category: "Backend",
    items: [
      { name: "C#", level: "Advanced", icon: "https://cdn.svgporn.com/logos/c-sharp.svg" },
      { name: "Python", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/python.svg" },
      { name: "Java", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/java.svg" },
      { name: "TypeScript", level: "Beginner", icon: "https://cdn.svgporn.com/logos/typescript-icon.svg" },
      { name: "Node.js", level: "Beginner", icon: "https://cdn.svgporn.com/logos/nodejs.svg" },
    ],
  },
  {
    category: "Mobile",
    items: [
      { name: "Swift", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/swift.svg" },
    ],
  },
  {
    category: "Infrastructure",
    items: [
      { name: "AWS", level: "Advanced", icon: "https://cdn.svgporn.com/logos/aws.svg" },
      { name: "Firebase", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/firebase.svg" },
    ],
  },
  {
    category: "Database",
    items: [
      { name: "Oracle", level: "Advanced", icon: "https://cdn.svgporn.com/logos/oracle.svg" },
      { name: "PostgreSQL", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/postgresql.svg" },
      { name: "SQLite", level: "Beginner", icon: "https://cdn.svgporn.com/logos/sqlite.svg" },
    ],
  },
  {
    category: "Game Dev",
    items: [
      { name: "Unity", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/unity.svg" },
    ],
  },
];

const levelColor = (level: string) => {
  switch (level) {
    case "Advanced": return "#6366f1";
    case "Intermediate": return "#3b82f6";
    case "Beginner": return "#22c55e";
    default: return "#94a3b8";
  }
};

const levelBg = (level: string) => {
  switch (level) {
    case "Advanced": return "rgba(99, 102, 241, 0.08)";
    case "Intermediate": return "rgba(59, 130, 246, 0.08)";
    case "Beginner": return "rgba(34, 197, 94, 0.08)";
    default: return "rgba(148, 163, 184, 0.08)";
  }
};
---

<Layout title={pageTitle}>
  <!-- Profile Section -->
  <section class="profile-section">
    <div class="profile-bg"></div>
    <div class="profile-layout reveal">
      <div class="profile-image-wrap">
        <Image
          src={selfie}
          alt="冨谷 彰吾"
          width={240}
          height={240}
          class="profile-img"
        />
      </div>
      <div class="profile-info">
        <p class="mono-label">Profile</p>
        <h1 class="profile-name">冨谷 彰吾</h1>
        <p class="profile-tagline">Software Engineer / Freelance</p>
        <p class="profile-bio">
          千葉県在住。新卒から未経験でSES企業に入社し、現在はフリーランスエンジニアとして活動中。
        </p>
        <div class="profile-links">
          {sns.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="sns-link">
              <img src={s.icon} alt={s.name} width="18" height="18" />
              <span>{s.name}</span>
              <svg width="10" height="10" viewBox="0 0 12 12" fill="none">
                <path d="M3.5 1.5H10.5V8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M10.5 1.5L1.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <hr />

  <!-- GitHub Stats -->
  <section class="github-section reveal reveal-delay-1">
    <p class="mono-label">GitHub Activity</p>
    <h2>Stats & Contributions</h2>
    <div class="stats-grid">
      <div class="stat-card glass">
        <img
          src="https://github-readme-stats.vercel.app/api?username=tomyshogo&show_icons=true&theme=default&hide_border=true&title_color=6366f1&text_color=6b7280&icon_color=6366f1&bg_color=00000000"
          alt="GitHub Stats"
          loading="lazy"
        />
      </div>
      <div class="stat-card glass">
        <img
          src="https://github-readme-stats.vercel.app/api/top-langs/?username=tomyshogo&langs_count=5&hide=html,cmake&theme=default&hide_border=true&title_color=6366f1&text_color=6b7280&bg_color=00000000&layout=compact"
          alt="Top Languages"
          loading="lazy"
        />
      </div>
    </div>
    <div class="stat-wide glass">
      <img
        src="https://github-profile-summary-cards.vercel.app/api/cards/profile-details?username=tomyshogo&theme=default"
        alt="Profile Summary"
        loading="lazy"
      />
    </div>
  </section>

  <hr />

  <!-- Skills Section -->
  <section class="skills-section reveal reveal-delay-2">
    <p class="mono-label">Tech Stack</p>
    <h2>Skills & Expertise</h2>

    <div class="level-legend">
      <span class="legend-item"><span class="legend-dot" style="background: #6366f1"></span>Advanced</span>
      <span class="legend-item"><span class="legend-dot" style="background: #3b82f6"></span>Intermediate</span>
      <span class="legend-item"><span class="legend-dot" style="background: #22c55e"></span>Beginner</span>
    </div>

    <div class="skills-grid">
      {skills.map((group) => (
        <div class="skill-group glass">
          <h3 class="group-title">{group.category}</h3>
          <div class="skill-items">
            {group.items.map((skill) => (
              <div class="skill-item">
                <div class="skill-icon-wrap">
                  <img src={skill.icon} alt={skill.name} width="22" height="22" loading="lazy" />
                </div>
                <span class="skill-name">{skill.name}</span>
                <span class="skill-level" style={`color: ${levelColor(skill.level)}; background: ${levelBg(skill.level)}`}>
                  {skill.level}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Interests -->
  <section class="interests-section reveal reveal-delay-3">
    <p class="mono-label">Interests</p>
    <h2>What I'm Into</h2>
    <div class="interests-grid">
      <div class="interest-card glass">
        <span class="interest-emoji">🎮</span>
        <h3>Game Development</h3>
        <p>Unityを使ったゲーム開発</p>
      </div>
      <div class="interest-card glass">
        <span class="interest-emoji">📡</span>
        <h3>IoT Product</h3>
        <p>IoTプロダクトの設計と開発</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Profile */
  .profile-section {
    position: relative;
    padding: 3rem 0 1rem;
    margin: -2rem -2rem 0;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .profile-bg {
    position: absolute;
    inset: 0;
    background: var(--gradient-hero);
    z-index: -1;
  }

  .profile-layout {
    display: flex;
    gap: 3rem;
    align-items: center;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .profile-image-wrap {
    flex-shrink: 0;
  }

  .profile-img {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid #ffffff;
    box-shadow: var(--shadow-lg);
    transition: transform 0.4s ease;
  }

  .profile-img:hover {
    transform: scale(1.05);
  }

  .profile-name {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    margin: 0.5rem 0 0.25rem;
  }

  .profile-tagline {
    font-size: 0.9rem;
    font-weight: 600;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
  }

  .profile-bio {
    margin-top: 1rem;
    max-width: 420px;
    line-height: 1.9;
  }

  .profile-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .sns-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    border-radius: 0.75rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    transition: all 0.2s ease;
  }

  .sns-link:hover {
    color: var(--accent);
    border-color: rgba(99, 102, 241, 0.3);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  /* GitHub Stats */
  .github-section {
    padding: 1rem 0;
  }

  .github-section h2 {
    margin: 0.75rem 0 1.5rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .stat-card {
    padding: 1.25rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-card img {
    width: 100%;
    max-width: 400px;
  }

  .stat-wide {
    padding: 1.25rem;
    overflow: hidden;
    display: flex;
    justify-content: center;
  }

  .stat-wide img {
    width: 100%;
    max-width: 800px;
  }

  /* Skills */
  .skills-section {
    padding: 1rem 0;
  }

  .skills-section h2 {
    margin: 0.75rem 0 1rem;
  }

  .level-legend {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .skill-group {
    padding: 1.5rem;
  }

  .group-title {
    font-size: 0.85rem;
    font-weight: 700;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .skill-items {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .skill-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .skill-icon-wrap {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-secondary);
    border-radius: 0.625rem;
    flex-shrink: 0;
  }

  .skill-icon-wrap img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  .skill-name {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-primary);
    flex: 1;
  }

  .skill-level {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 1rem;
  }

  /* Interests */
  .interests-section {
    padding: 1rem 0 2rem;
  }

  .interests-section h2 {
    margin: 0.75rem 0 1.5rem;
  }

  .interests-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .interest-card {
    padding: 2rem;
    text-align: center;
  }

  .interest-emoji {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 0.75rem;
  }

  .interest-card h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
  }

  .interest-card p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .profile-section {
      padding: 2rem;
    }

    .profile-layout {
      flex-direction: column;
      text-align: center;
      gap: 1.5rem;
    }

    .profile-img {
      width: 140px;
      height: 140px;
    }

    .profile-bio {
      max-width: 100%;
    }

    .profile-links {
      justify-content: center;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }

    .interests-grid {
      grid-template-columns: 1fr;
    }

    .level-legend {
      flex-wrap: wrap;
      gap: 1rem;
    }
  }
</style>
