---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import selfie from "../assets/IMG_4381.jpg";

const pageTitle = "tomy | about";

const sns = [
  {
    name: "GitHub",
    url: "https://github.com/tomyshogo",
    icon: "https://cdn.svgporn.com/logos/github-icon.svg",
  },
];

const skills = [
  {
    category: "Frontend",
    items: [
      { name: "JavaScript", level: "Advanced", icon: "https://cdn.svgporn.com/logos/javascript.svg" },
      { name: "React", level: "Beginner", icon: "https://cdn.svgporn.com/logos/react.svg" },
      { name: "Vue", level: "Beginner", icon: "https://cdn.svgporn.com/logos/vue.svg" },
    ],
  },
  {
    category: "Backend",
    items: [
      { name: "C#", level: "Advanced", icon: "https://cdn.svgporn.com/logos/c-sharp.svg" },
      { name: "Python", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/python.svg" },
      { name: "Java", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/java.svg" },
      { name: "TypeScript", level: "Beginner", icon: "https://cdn.svgporn.com/logos/typescript-icon.svg" },
      { name: "Node.js", level: "Beginner", icon: "https://cdn.svgporn.com/logos/nodejs.svg" },
    ],
  },
  {
    category: "Mobile",
    items: [
      { name: "Swift", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/swift.svg" },
    ],
  },
  {
    category: "Infrastructure",
    items: [
      { name: "AWS", level: "Advanced", icon: "https://cdn.svgporn.com/logos/aws.svg" },
      { name: "Firebase", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/firebase.svg" },
    ],
  },
  {
    category: "Database",
    items: [
      { name: "Oracle", level: "Advanced", icon: "https://cdn.svgporn.com/logos/oracle.svg" },
      { name: "PostgreSQL", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/postgresql.svg" },
      { name: "SQLite", level: "Beginner", icon: "https://cdn.svgporn.com/logos/sqlite.svg" },
    ],
  },
  {
    category: "Game Dev",
    items: [
      { name: "Unity", level: "Intermediate", icon: "https://cdn.svgporn.com/logos/unity.svg" },
    ],
  },
];

const levelStyle = (level: string) => {
  switch (level) {
    case "Advanced": return "level-advanced";
    case "Intermediate": return "level-intermediate";
    case "Beginner": return "level-beginner";
    default: return "";
  }
};
---

<Layout title={pageTitle}>
  <!-- Profile - Notion-style block -->
  <section class="profile reveal">
    <div class="profile-layout">
      <div class="profile-image-wrap">
        <div class="image-glow"></div>
        <Image
          src={selfie}
          alt="冨谷 彰吾"
          width={240}
          height={240}
          class="profile-img"
        />
      </div>
      <div class="profile-info">
        <div class="section-label">Profile</div>
        <h1 class="profile-name">冨谷 彰吾</h1>
        <p class="profile-role">Software Engineer / Freelance</p>
        <p class="profile-bio">
          千葉県在住。新卒から未経験でSES企業に入社し、現在はフリーランスエンジニアとして活動中。
        </p>
        <div class="profile-links">
          {sns.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="sns-chip">
              <img src={s.icon} alt={s.name} width="16" height="16" />
              {s.name} ↗
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <hr />

  <!-- GitHub Stats -->
  <section class="reveal reveal-delay-1">
    <div class="section-label">GitHub Activity</div>
    <h2>Stats & Contributions</h2>
    <div class="stats-bento">
      <div class="stat-card notion-block">
        <img
          src="https://github-readme-stats.vercel.app/api?username=tomyshogo&show_icons=true&hide_border=true&title_color=a78bfa&text_color=a7a7b4&icon_color=22d3ee&bg_color=00000000"
          alt="GitHub Stats"
          loading="lazy"
        />
      </div>
      <div class="stat-card notion-block">
        <img
          src="https://github-readme-stats.vercel.app/api/top-langs/?username=tomyshogo&langs_count=5&hide=html,cmake&hide_border=true&title_color=a78bfa&text_color=a7a7b4&bg_color=00000000&layout=compact"
          alt="Top Languages"
          loading="lazy"
        />
      </div>
    </div>
    <div class="stat-wide notion-block">
      <img
        src="https://github-profile-summary-cards.vercel.app/api/cards/profile-details?username=tomyshogo&theme=github_dark"
        alt="Profile Summary"
        loading="lazy"
      />
    </div>
  </section>

  <hr />

  <!-- Skills - Bento with emoji headers -->
  <section class="reveal reveal-delay-2">
    <div class="section-label">Tech Stack</div>
    <h2>Skills & Expertise</h2>

    <div class="level-legend">
      <span class="legend-item"><span class="legend-dot dot-advanced"></span> Advanced</span>
      <span class="legend-item"><span class="legend-dot dot-intermediate"></span> Intermediate</span>
      <span class="legend-item"><span class="legend-dot dot-beginner"></span> Beginner</span>
    </div>

    <div class="skills-bento">
      {skills.map((group) => (
        <div class="skill-group glow-card">
          <h3 class="group-title">{group.category}</h3>
          <div class="skill-items">
            {group.items.map((skill) => (
              <div class="skill-item">
                <div class="skill-icon">
                  <img src={skill.icon} alt={skill.name} width="20" height="20" loading="lazy" />
                </div>
                <span class="skill-name">{skill.name}</span>
                <span class={`skill-level ${levelStyle(skill.level)}`}>
                  {skill.level}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Interests -->
  <section class="interests reveal reveal-delay-3">
    <div class="section-label">Interests</div>
    <h2>What I'm Into</h2>
    <div class="interests-grid">
      <div class="interest-item glow-card">
        <h3>Game Development</h3>
        <p>Unityを使ったゲーム開発</p>
      </div>
      <div class="interest-item glow-card">
        <h3>IoT Product</h3>
        <p>IoTプロダクトの設計と開発</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Profile */
  .profile {
    padding: 3rem 0 1rem;
  }

  .profile-layout {
    display: flex;
    gap: 2.5rem;
    align-items: center;
  }

  .profile-image-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .profile-image-wrap .image-glow {
    position: absolute;
    width: 200px;
    height: 200px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(139, 92, 246, 0.3) 0%, transparent 70%);
    border-radius: 50%;
    filter: blur(24px);
  }

  .profile-img {
    position: relative;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border-medium);
    box-shadow: var(--shadow-md), 0 0 32px rgba(139, 92, 246, 0.2);
    transition: transform 0.4s var(--ease-spring);
  }

  .profile-img:hover {
    transform: scale(1.03);
  }

  .profile-name {
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin: 0.4rem 0 0.2rem;
  }

  .profile-role {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0;
  }

  .profile-bio {
    margin-top: 0.75rem;
    max-width: 400px;
  }

  .profile-links {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .sns-chip img {
    filter: invert(1);
  }

  .sns-chip {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 0.375rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.15s ease;
  }

  .sns-chip:hover {
    color: var(--accent);
    border-color: rgba(124, 58, 237, 0.2);
    background: var(--accent-light);
  }

  /* Section headers */
  h2 {
    margin: 0.5rem 0 1.25rem;
  }

  /* GitHub Stats - Bento-like */
  .stats-bento {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .stat-card {
    padding: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .stat-card img {
    width: 100%;
    max-width: 400px;
  }

  .stat-wide {
    padding: 1.25rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
  }

  .stat-wide img {
    width: 100%;
    max-width: 800px;
  }

  /* Skills - Bento grid */
  .level-legend {
    display: flex;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .legend-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .dot-advanced { background: var(--accent); box-shadow: 0 0 6px var(--accent-glow-strong); }
  .dot-intermediate { background: #60a5fa; box-shadow: 0 0 6px rgba(96, 165, 250, 0.4); }
  .dot-beginner { background: #4ade80; box-shadow: 0 0 6px rgba(74, 222, 128, 0.4); }

  .skills-bento {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .skill-group {
    padding: 1.5rem;
  }

  .group-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .skill-items {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .skill-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .skill-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.92);
    border-radius: 0.5rem;
    flex-shrink: 0;
    transition: transform 0.3s var(--ease-spring);
  }

  .skill-item:hover .skill-icon {
    transform: scale(1.12) rotate(-4deg);
  }

  .skill-icon img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .skill-name {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-primary);
    flex: 1;
  }

  .skill-level {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.5rem;
    border-radius: 0.25rem;
  }

  .level-advanced {
    color: var(--accent-hover);
    background: rgba(167, 139, 250, 0.12);
  }

  .level-intermediate {
    color: #93c5fd;
    background: rgba(96, 165, 250, 0.12);
  }

  .level-beginner {
    color: #86efac;
    background: rgba(74, 222, 128, 0.12);
  }

  /* Interests */
  .interests {
    padding: 1rem 0 2rem;
  }

  .interests-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .interest-item {
    padding: 1.75rem;
    text-align: center;
  }

  .interest-item h3 {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.3rem;
  }

  .interest-item p {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .profile-layout {
      flex-direction: column;
      text-align: center;
      gap: 1.5rem;
    }

    .profile-img {
      width: 130px;
      height: 130px;
    }

    .profile-bio {
      max-width: 100%;
    }

    .profile-links {
      justify-content: center;
    }

    .stats-bento {
      grid-template-columns: 1fr;
    }

    .skills-bento {
      grid-template-columns: 1fr;
    }

    .interests-grid {
      grid-template-columns: 1fr;
    }

    .level-legend {
      flex-wrap: wrap;
    }
  }
</style>
