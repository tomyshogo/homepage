---
import Layout from "../layouts/Layout.astro";
import BlogPost from "../components/BlogPost.astro";
import SplitText from "../components/SplitText.astro";

const allPosts = await Astro.glob("../pages/posts/*.md");
const sorted = [...allPosts].sort((a, b) =>
  String(b.frontmatter.pubDate ?? "").localeCompare(String(a.frontmatter.pubDate ?? ""))
);

const tagCount = new Set(allPosts.flatMap((post) => post.frontmatter.tags ?? [])).size;
const pageTitle = "tomy | blog";
---

<Layout title={pageTitle}>
  <section class="page-head">
    <span class="mono-label reveal">Blog</span>
    <h1 class="reveal reveal-chars">
      <SplitText text="Blog" />
    </h1>
    <p class="page-desc reveal reveal-delay-2">
      日々の思考整理と記録。<span class="serif">life</span> リポジトリから同期しています。
    </p>

    {allPosts.length > 0 && (
      <div class="head-stats reveal reveal-delay-3">
        <span><strong data-count={allPosts.length}>0</strong> posts</span>
        <span class="head-sep"></span>
        <span><strong data-count={tagCount}>0</strong> tags</span>
      </div>
    )}
  </section>

  {allPosts.length > 0 && (
    <div class="blog-controls reveal reveal-delay-3">
      <a href="/tags/" class="tags-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" />
          <circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />
        </svg>
        Browse tags
        <span class="btn-arrow">→</span>
      </a>

      <div class="select-wrapper">
        <select id="post-sort" aria-label="Sort posts">
          <option value="latest">New → Old</option>
          <option value="oldest">Old → New</option>
        </select>
      </div>
    </div>
  )}

  {allPosts.length > 0 ? (
    <ul class="post-grid" id="post-list" data-stagger="0.08">
      {sorted.map((post) => <BlogPost post={post} />)}
    </ul>
  ) : (
    <div class="empty-state reveal">
      <div class="empty-visual" aria-hidden="true">
        <span class="empty-line"></span>
        <span class="empty-line short"></span>
        <span class="empty-line shorter"></span>
      </div>
      <p class="empty-title">Coming soon</p>
      <p class="empty-desc">記事は準備中です。life リポからの同期をお楽しみに。</p>
    </div>
  )}
</Layout>

<style>
  .head-stats {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .head-stats strong {
    color: var(--accent);
    font-weight: 600;
  }

  .head-sep {
    width: 1px;
    height: 12px;
    background: var(--border-medium);
  }

  .blog-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .tags-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    transition: all 0.3s var(--ease-smooth);
  }

  .tags-link:hover {
    color: var(--accent);
    border-color: var(--accent-glow-strong);
    background: var(--accent-dim);
  }

  .tags-link:hover .btn-arrow { transform: translateX(4px); }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.1rem;
    list-style: none;
    padding: 0;
  }

  /* Empty state */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 5rem 2rem;
    text-align: center;
  }

  .empty-visual {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    align-items: center;
    margin-bottom: 2rem;
  }

  .empty-line {
    display: block;
    height: 3px;
    width: 130px;
    border-radius: 2px;
    background: var(--border-subtle);
    animation: shimmer 2.2s ease-in-out infinite;
  }

  .empty-line.short { width: 85px; animation-delay: 0.18s; }
  .empty-line.shorter { width: 52px; animation-delay: 0.36s; }

  @keyframes shimmer {
    0%, 100% { background: var(--border-subtle); }
    50% { background: var(--accent-glow); }
  }

  .empty-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .empty-desc {
    margin-top: 0.25rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .blog-controls {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }

    .tags-link { justify-content: center; }

    .post-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  function initSort() {
    const select = document.getElementById("post-sort") as HTMLSelectElement | null;
    const list = document.getElementById("post-list");
    if (!select || !list) return;

    select.addEventListener("change", () => {
      const items = Array.from(list.children) as HTMLElement[];
      items.reverse();

      // Fade out, reorder, fade back in so the change reads as a transition.
      list.style.transition = "opacity 0.2s ease";
      list.style.opacity = "0";

      window.setTimeout(() => {
        items.forEach((item, i) => {
          item.style.setProperty("--reveal-delay", `${i * 0.05}s`);
          list.appendChild(item);
        });
        list.style.opacity = "1";
      }, 200);
    });
  }

  document.addEventListener("astro:page-load", initSort);
</script>
