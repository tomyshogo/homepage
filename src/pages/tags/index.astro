---
import Layout from "../../layouts/Layout.astro";
import SplitText from "../../components/SplitText.astro";

const allPosts = await Astro.glob("../posts/*.md");

// Count posts per tag so the cloud can weight them.
const counts = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.frontmatter.tags ?? []) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const pageTitle = "tomy | tags";
---

<Layout title={pageTitle}>
  <section class="page-head">
    <a href="/blog/" class="back-link reveal">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2.2"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
      </svg>
      <span>Back to Blog</span>
    </a>

    <span class="mono-label reveal reveal-delay-1">Filter</span>
    <h1 class="reveal reveal-chars">
      <SplitText text="Tags" />
    </h1>
    <p class="page-desc reveal reveal-delay-2">
      {tags.length} 個のタグで記事を絞り込めます。
    </p>
  </section>

  <div class="tags-cloud" data-stagger="0.05">
    {tags.map(([tag, count]) => (
      <a href={`/tags/${tag}`} class="tag-chip reveal" data-magnetic="0.14">
        <span class="tag-hash">#</span>
        <span class="tag-name">{tag}</span>
        <span class="tag-count">{count}</span>
      </a>
    ))}
  </div>
</Layout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .back-link:hover { color: var(--accent); }

  .back-link svg {
    transition: transform 0.35s var(--ease-spring);
  }

  .back-link:hover svg { transform: translateX(-4px); }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 1.1rem;
    border-radius: 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-secondary);
    transition:
      transform 0.35s var(--ease-out-expo),
      color 0.3s ease,
      border-color 0.3s ease,
      background 0.3s ease,
      box-shadow 0.3s ease;
  }

  .tag-chip:hover {
    color: var(--accent-hover);
    border-color: var(--accent-glow-strong);
    background: var(--accent-dim);
    box-shadow: 0 8px 24px -10px var(--accent);
  }

  .tag-hash {
    color: var(--accent);
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  .tag-chip:hover .tag-hash { opacity: 1; }

  .tag-count {
    margin-left: 0.2rem;
    padding: 0.05rem 0.4rem;
    border-radius: 1rem;
    background: var(--bg-tertiary);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: all 0.3s ease;
  }

  .tag-chip:hover .tag-count {
    background: var(--accent);
    color: #08080c;
  }
</style>
