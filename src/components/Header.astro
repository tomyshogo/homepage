---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about/" },
  { label: "Works", href: "/works/" },
  { label: "Blog", href: "/blog/" },
];
---

<header id="site-header">
  <div class="scroll-progress" id="scroll-progress"></div>
  <nav class="nav">
    <a href="/" class="logo" aria-label="tomy — home">
      <span class="logo-mark">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <defs>
            <linearGradient id="logo-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#a78bfa" />
              <stop offset="50%" stop-color="#f472b6" />
              <stop offset="100%" stop-color="#2dd4bf" />
            </linearGradient>
          </defs>
          <path
            d="M4 7h16M12 7v12"
            stroke="url(#logo-grad)"
            stroke-width="2.4"
            stroke-linecap="round"
            fill="none"
          />
        </svg>
      </span>
      <span class="logo-text">tomy<span class="logo-dot">.</span></span>
    </a>

    <ul class="nav-links" id="nav-links">
      <span class="nav-pill" id="nav-pill" aria-hidden="true"></span>
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={["nav-link", { active: currentPath === item.href }]}
            data-nav-link
          >
            <span class="nav-label">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <button class="menu-toggle" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(8, 8, 12, 0.55);
    backdrop-filter: blur(20px) saturate(1.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
    border-bottom: 1px solid transparent;
    transition: background 0.4s var(--ease-smooth), border-color 0.4s var(--ease-smooth);
  }

  header.is-scrolled {
    background: rgba(8, 8, 12, 0.82);
    border-bottom-color: var(--border-subtle);
  }

  .scroll-progress {
    position: absolute;
    bottom: -1px;
    left: 0;
    height: 2px;
    width: 100%;
    background: var(--gradient-brand);
    background-size: 250% auto;
    animation: gradient-flow 7s linear infinite;
    transform: scaleX(0);
    transform-origin: left;
    z-index: 101;
  }

  .nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--text-primary);
  }

  .logo:hover { color: var(--text-primary); }

  .logo-mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    transition: transform 0.5s var(--ease-spring), border-color 0.3s ease;
  }

  .logo:hover .logo-mark {
    transform: rotate(-90deg) scale(1.06);
    border-color: var(--accent-glow-strong);
  }

  .logo-dot {
    background: var(--gradient-brand);
    background-size: 250% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradient-flow 7s linear infinite;
  }

  /* Nav with sliding pill */
  .nav-links {
    position: relative;
    display: flex;
    gap: 0.15rem;
    list-style: none;
  }

  .nav-pill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    border-radius: 0.55rem;
    background: var(--bg-card-hover);
    border: 1px solid var(--border-subtle);
    opacity: 0;
    transform: translateX(var(--pill-x, 0));
    width: var(--pill-w, 0);
    transition:
      transform 0.45s var(--ease-out-expo),
      width 0.45s var(--ease-out-expo),
      opacity 0.3s var(--ease-smooth);
    pointer-events: none;
  }

  .nav-links.pill-ready .nav-pill { opacity: 1; }

  .nav-link {
    position: relative;
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    padding: 0.45rem 0.9rem;
    border-radius: 0.55rem;
    transition: color 0.25s var(--ease-smooth);
  }

  .nav-link:hover { color: var(--text-primary); }

  .nav-link.active { color: var(--accent-hover); }

  /* Label lift on hover */
  .nav-label {
    display: inline-block;
    transition: transform 0.35s var(--ease-spring);
  }

  .nav-link:hover .nav-label { transform: translateY(-1px); }

  /* Mobile toggle */
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .bar {
    display: block;
    width: 19px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 1px;
    transition: transform 0.35s var(--ease-out-expo), opacity 0.2s ease;
  }

  @media (max-width: 680px) {
    .menu-toggle { display: flex; }

    .nav-pill { display: none; }

    .nav-links {
      position: fixed;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: rgba(8, 8, 12, 0.96);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: 0.75rem 2rem 1.5rem;
      border-bottom: 1px solid var(--border-subtle);
      clip-path: inset(0 0 100% 0);
      opacity: 0;
      pointer-events: none;
      transition: clip-path 0.5s var(--ease-out-expo), opacity 0.3s ease;
    }

    .nav-links.is-open {
      clip-path: inset(0 0 0 0);
      opacity: 1;
      pointer-events: auto;
    }

    .nav-links li {
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.4s var(--ease-out-expo), transform 0.4s var(--ease-out-expo);
    }

    .nav-links.is-open li { opacity: 1; transform: none; }
    .nav-links.is-open li:nth-child(2) { transition-delay: 0.05s; }
    .nav-links.is-open li:nth-child(3) { transition-delay: 0.1s; }
    .nav-links.is-open li:nth-child(4) { transition-delay: 0.15s; }
    .nav-links.is-open li:nth-child(5) { transition-delay: 0.2s; }

    .nav-link {
      font-size: 1.05rem;
      font-weight: 600;
      padding: 0.7rem 0;
      border-bottom: 1px solid var(--border-subtle);
      border-radius: 0;
    }

    .menu-toggle.is-open .bar:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }

    .menu-toggle.is-open .bar:last-child {
      transform: translateY(-3.5px) rotate(-45deg);
    }
  }
</style>

<script>
  // Window-level listeners survive view transitions, so drop the previous set first.
  let teardown: (() => void) | null = null;

  function initHeader() {
    teardown?.();

    const header = document.getElementById("site-header");
    const toggle = document.getElementById("menu-toggle");
    const links = document.getElementById("nav-links");
    const pill = document.getElementById("nav-pill");
    const progress = document.getElementById("scroll-progress");

    // Mobile menu
    toggle?.addEventListener("click", () => {
      const open = toggle.classList.toggle("is-open");
      links?.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    });

    // Sliding pill follows hover, rests on the active link
    let onResize: (() => void) | null = null;

    if (links && pill) {
      const anchors = Array.from(links.querySelectorAll<HTMLElement>("[data-nav-link]"));
      const active = anchors.find((a) => a.classList.contains("active"));

      const moveTo = (el: HTMLElement | undefined) => {
        if (!el) {
          links.classList.remove("pill-ready");
          return;
        }
        pill.style.setProperty("--pill-x", `${el.offsetLeft}px`);
        pill.style.setProperty("--pill-w", `${el.offsetWidth}px`);
        links.classList.add("pill-ready");
      };

      moveTo(active);
      anchors.forEach((a) => a.addEventListener("pointerenter", () => moveTo(a)));
      links.addEventListener("pointerleave", () => moveTo(active));

      onResize = () => moveTo(active);
      window.addEventListener("resize", onResize, { passive: true });
    }

    // Scroll progress + header condense
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? window.scrollY / max : 0;
      if (progress) {
        progress.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
      }
      header?.classList.toggle("is-scrolled", window.scrollY > 8);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    teardown = () => {
      window.removeEventListener("scroll", onScroll);
      if (onResize) window.removeEventListener("resize", onResize);
    };
  }

  document.addEventListener("astro:page-load", initHeader);
</script>
