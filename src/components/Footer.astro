---
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <p class="footer-copy">&copy; {year} tomy</p>
    <a
      href="https://github.com/tomyshogo"
      target="_blank"
      rel="noopener noreferrer"
      class="footer-link"
    >
      GitHub ↗
    </a>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border-subtle);
    padding: 2rem 0;
    background: var(--bg-primary);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .footer-link {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>
