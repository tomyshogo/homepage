---
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <div class="footer-left">
      <span class="footer-logo">tomy<span class="dot">.</span></span>
      <p class="footer-copy">&copy; {year} tomy. All rights reserved.</p>
    </div>
    <div class="footer-links">
      <a
        href="https://github.com/tomyshogo"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M3.5 1.5H10.5V8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M10.5 1.5L1.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border-subtle);
    padding: 2.5rem 0;
    position: relative;
    z-index: 1;
    background: var(--bg-secondary);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-logo {
    font-family: var(--font-sans);
    font-weight: 800;
    color: var(--text-primary);
    font-size: 1.1rem;
    letter-spacing: -0.03em;
  }

  .footer-logo .dot {
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
